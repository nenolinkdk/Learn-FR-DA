{"schemaVersion":1,"contentVersion":"0.1.0-children-06-10","course":{"id":"course.fr-da","courseLocale":"fr-FR","languages":{"support":{"language":"fr","locale":"fr-FR"},"target":{"language":"da","locale":"da-DK"}},"tts":{"primaryRole":"target","targetLocale":"da-DK","supportLocale":"fr-FR"},"title":{"support":"Danois pratique","target":"Praktisk dansk"},"modules":[{"id":"module.children","type":"children","audience":"children","title":{"support":"Enfants — Le danois au quotidien","target":"Børn — Dansk i hverdagen"},"tags":["children","everyday","safety"],"lessons":[{"id":"lesson.children.swimming","moduleId":"module.children","order":6,"title":{"support":"À la piscine","target":"I svømmehallen"},"situation":{"support":"Tu vas à la piscine avec ta famille ou ton groupe. Tu dois trouver le vestiaire, comprendre une règle et demander où tu peux nager.","target":"Du er i svømmehallen med din familie eller gruppe. Du skal finde omklædningen, forstå en regel og spørge, hvor du må svømme."},"tags":["swimming","rules"],"items":[{"id":"item.children.swimming.1","order":1,"type":"dialogue-turn","speaker":"A","text":{"support":"Où sont les vestiaires ?","target":"Hvor er omklædningsrummene?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["directions"]},{"id":"item.children.swimming.2","order":2,"type":"dialogue-turn","speaker":"B","text":{"support":"Ils sont à gauche après l’entrée.","target":"De er til venstre efter indgangen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["directions"]},{"id":"item.children.swimming.3","order":3,"type":"dialogue-turn","speaker":"A","text":{"support":"Où dois-je mettre mes chaussures ?","target":"Hvor skal jeg stille mine sko?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["rules"]},{"id":"item.children.swimming.4","order":4,"type":"dialogue-turn","speaker":"B","text":{"support":"Mets-les ici avant d’entrer dans le vestiaire.","target":"Stil dem her, før du går ind i omklædningsrummet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["instruction"]},{"id":"item.children.swimming.5","order":5,"type":"dialogue-turn","speaker":"A","text":{"support":"Je peux nager dans ce bassin ?","target":"Må jeg svømme i det her bassin?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["permission"]},{"id":"item.children.swimming.6","order":6,"type":"dialogue-turn","speaker":"B","text":{"support":"Oui, si tu peux nager sans aide.","target":"Ja, hvis du kan svømme uden hjælp."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"cultural":{"support":"Les règles de sécurité et d’accès aux bassins varient. Il faut toujours suivre les panneaux et les instructions du personnel."}},"tags":["safety"]},{"id":"item.children.swimming.7","order":7,"type":"dialogue-turn","speaker":"A","text":{"support":"L’eau est profonde ici ?","target":"Er vandet dybt her?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["safety"]},{"id":"item.children.swimming.8","order":8,"type":"dialogue-turn","speaker":"B","text":{"support":"Regarde le panneau au bord du bassin.","target":"Se skiltet ved bassinet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["instruction"]},{"id":"item.children.swimming.9","order":9,"type":"dialogue-turn","speaker":"A","text":{"support":"J’ai besoin d’aide.","target":"Jeg har brug for hjælp."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["help"]},{"id":"item.children.swimming.10","order":10,"type":"dialogue-turn","speaker":"B","text":{"support":"Reste là. Je vais chercher un adulte.","target":"Bliv der. Jeg henter en voksen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["safety","help"]}],"quiz":{"id":"quiz.children.swimming","title":{"support":"Mini-quiz — Piscine","target":"Miniquiz — Svømmehal"},"questions":[{"id":"q.children.swimming.1","order":1,"type":"single-choice","prompt":{"support":"Comment demandes-tu la permission de nager dans un bassin ?","target":"Hvordan spørger du om lov til at svømme i et bassin?"},"answers":[{"id":"a.children.swimming.1c","text":{"support":"Je peux nager dans ce bassin ?","target":"Må jeg svømme i det her bassin?"},"correct":true},{"id":"a.children.swimming.1w1","text":{"support":"Où est le bus ?","target":"Hvor er bussen?"},"correct":false},{"id":"a.children.swimming.1w2","text":{"support":"Je veux rentrer.","target":"Jeg vil hjem."},"correct":false}],"explanation":{"support":"« Må jeg …? » demande la permission.","target":"‘Må jeg …?’ bruges til at spørge om lov."},"tags":["permission"]},{"id":"q.children.swimming.2","order":2,"type":"single-choice","prompt":{"support":"Que signifie « dybt » ?","target":"Hvad betyder ‘dybt’?"},"answers":[{"id":"a.children.swimming.2c","text":{"support":"profond","target":"dybt"},"correct":true},{"id":"a.children.swimming.2w1","text":{"support":"chaud","target":"varmt"},"correct":false},{"id":"a.children.swimming.2w2","text":{"support":"vide","target":"tomt"},"correct":false}],"explanation":{"support":"« Dybt » décrit ici la profondeur de l’eau.","target":"‘Dybt’ beskriver vandets dybde."},"tags":["safety"]},{"id":"q.children.swimming.3","order":3,"type":"single-choice","prompt":{"support":"Comment dis-tu que tu as besoin d’aide ?","target":"Hvordan siger du, at du har brug for hjælp?"},"answers":[{"id":"a.children.swimming.3c","text":{"support":"J’ai besoin d’aide.","target":"Jeg har brug for hjælp."},"correct":true},{"id":"a.children.swimming.3w1","text":{"support":"Je sais nager.","target":"Jeg kan svømme."},"correct":false},{"id":"a.children.swimming.3w2","text":{"support":"J’ai froid.","target":"Jeg fryser."},"correct":false}],"explanation":{"support":"C’est une phrase essentielle dans de nombreuses situations.","target":"Det er en vigtig sætning, når et barn har brug for hjælp."},"tags":["help"]}]}},{"id":"lesson.children.transport","moduleId":"module.children","order":7,"title":{"support":"Bus, train et trajet","target":"Bus, tog og rejse"},"situation":{"support":"Tu voyages avec un adulte, mais tu dois aussi pouvoir comprendre l’arrêt, le quai et demander si c’est le bon bus ou le bon train.","target":"Du rejser med en voksen, men skal også kunne forstå stoppested og spor og spørge, om det er den rigtige bus eller det rigtige tog."},"tags":["transport","travel"],"items":[{"id":"item.children.transport.1","order":1,"type":"dialogue-turn","speaker":"A","text":{"support":"C’est le bon bus ?","target":"Er det den rigtige bus?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["bus"]},{"id":"item.children.transport.2","order":2,"type":"dialogue-turn","speaker":"B","text":{"support":"Oui, il va à la gare.","target":"Ja, den kører til stationen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["bus"]},{"id":"item.children.transport.3","order":3,"type":"dialogue-turn","speaker":"A","text":{"support":"Où devons-nous descendre ?","target":"Hvor skal vi stå af?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Stå af » = descendre d’un moyen de transport.","targetExample":"Hvor skal vi stå af?"}},"tags":["phrasal-verb"]},{"id":"item.children.transport.4","order":4,"type":"dialogue-turn","speaker":"B","text":{"support":"À l’arrêt suivant.","target":"Ved næste stoppested."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["stop"]},{"id":"item.children.transport.5","order":5,"type":"digital-scenario","speaker":"A","text":{"support":"L’application dit que le train est retardé.","target":"Appen siger, at toget er forsinket."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"digital":{"support":"Un enfant peut voir des informations de trajet sur le téléphone d’un adulte ou sur un écran. Les applications exactes peuvent changer."}},"tags":["app","delay"]},{"id":"item.children.transport.6","order":6,"type":"dialogue-turn","speaker":"A","text":{"support":"De quel quai part le train ?","target":"Hvilket spor kører toget fra?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["train"]},{"id":"item.children.transport.7","order":7,"type":"dialogue-turn","speaker":"B","text":{"support":"Du quai quatre.","target":"Fra spor fire."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["numbers"]},{"id":"item.children.transport.8","order":8,"type":"dialogue-turn","speaker":"A","text":{"support":"On a le temps ?","target":"Har vi tid nok?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["time"]},{"id":"item.children.transport.9","order":9,"type":"dialogue-turn","speaker":"B","text":{"support":"Oui, mais nous devons y aller maintenant.","target":"Ja, men vi skal gå nu."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["time"]},{"id":"item.children.transport.10","order":10,"type":"dialogue-turn","speaker":"A","text":{"support":"D’accord, je reste avec toi.","target":"Okay, jeg bliver sammen med dig."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["safety"]}],"quiz":{"id":"quiz.children.transport","title":{"support":"Mini-quiz — Transport","target":"Miniquiz — Transport"},"questions":[{"id":"q.children.transport.1","order":1,"type":"single-choice","prompt":{"support":"Que signifie « stå af » ?","target":"Hvad betyder ‘stå af’?"},"answers":[{"id":"a.children.transport.1c","text":{"support":"descendre","target":"stå af"},"correct":true},{"id":"a.children.transport.1w1","text":{"support":"monter","target":"stige på"},"correct":false},{"id":"a.children.transport.1w2","text":{"support":"courir","target":"løbe"},"correct":false}],"explanation":{"support":"« Stå af » est utilisé pour descendre du bus, du train, etc.","target":"Man ‘står af’ en bus eller et tog."},"tags":["transport"]},{"id":"q.children.transport.2","order":2,"type":"single-choice","prompt":{"support":"Comment demandes-tu si c’est le bon bus ?","target":"Hvordan spørger du, om det er den rigtige bus?"},"answers":[{"id":"a.children.transport.2c","text":{"support":"C’est le bon bus ?","target":"Er det den rigtige bus?"},"correct":true},{"id":"a.children.transport.2w1","text":{"support":"Le bus est grand ?","target":"Er bussen stor?"},"correct":false},{"id":"a.children.transport.2w2","text":{"support":"Tu conduis le bus ?","target":"Kører du bussen?"},"correct":false}],"explanation":{"support":"« Den rigtige » signifie le bon/la bonne dans ce contexte.","target":"‘Den rigtige bus’ betyder den bus, man skal bruge."},"tags":["bus"]},{"id":"q.children.transport.3","order":3,"type":"single-choice","prompt":{"support":"Que signifie « forsinket » ?","target":"Hvad betyder ‘forsinket’?"},"answers":[{"id":"a.children.transport.3c","text":{"support":"en retard","target":"forsinket"},"correct":true},{"id":"a.children.transport.3w1","text":{"support":"fermé","target":"lukket"},"correct":false},{"id":"a.children.transport.3w2","text":{"support":"gratuit","target":"gratis"},"correct":false}],"explanation":{"support":"« Forsinket » indique que quelque chose arrive plus tard que prévu.","target":"‘Forsinket’ betyder senere end planlagt."},"tags":["delay"]}]}},{"id":"lesson.children.internet","moduleId":"module.children","order":8,"title":{"support":"Téléphone, jeux et Internet","target":"Telefon, spil og internet"},"situation":{"support":"Tu joues en ligne et utilises un téléphone ou une tablette. Tu apprends à demander le Wi-Fi, à parler d’un problème technique et à protéger tes informations personnelles.","target":"Du spiller online og bruger telefon eller tablet. Du lærer at spørge om wi-fi, fortælle om et teknisk problem og passe på personlige oplysninger."},"tags":["internet","games","safety"],"items":[{"id":"item.children.internet.1","order":1,"type":"digital-scenario","speaker":"A","text":{"support":"Il y a du Wi-Fi ici ?","target":"Er der wi-fi her?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["wifi"]},{"id":"item.children.internet.2","order":2,"type":"digital-scenario","speaker":"B","text":{"support":"Oui, mais demande à un adulte avant de te connecter.","target":"Ja, men spørg en voksen, før du logger på."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["safety"]},{"id":"item.children.internet.3","order":3,"type":"digital-scenario","speaker":"A","text":{"support":"Le jeu ne fonctionne pas.","target":"Spillet virker ikke."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["games","problem"]},{"id":"item.children.internet.4","order":4,"type":"digital-scenario","speaker":"A","text":{"support":"Je n’arrive pas à me connecter.","target":"Jeg kan ikke logge ind."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["login"]},{"id":"item.children.internet.5","order":5,"type":"dialogue-turn","speaker":"B","text":{"support":"Ne donne ton mot de passe à personne.","target":"Giv ikke dit kodeord til nogen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"digital":{"support":"Les enfants ne doivent pas partager mots de passe, codes ou informations privées avec d’autres joueurs ou des inconnus."}},"tags":["privacy","safety"]},{"id":"item.children.internet.6","order":6,"type":"dialogue-turn","speaker":"A","text":{"support":"Quelqu’un me demande mon vrai nom.","target":"Der er en, der spørger efter mit rigtige navn."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["privacy"]},{"id":"item.children.internet.7","order":7,"type":"dialogue-turn","speaker":"B","text":{"support":"Tu n’as pas besoin de le donner. Parle à un adulte si tu n’es pas sûr.","target":"Du behøver ikke give det. Tal med en voksen, hvis du er i tvivl."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Behøver ikke » = ne pas avoir besoin de. « I tvivl » = dans le doute/ne pas être sûr.","targetExample":"Du behøver ikke gøre det."}},"tags":["safety","modal"]},{"id":"item.children.internet.8","order":8,"type":"digital-scenario","speaker":"A","text":{"support":"Je veux bloquer cette personne.","target":"Jeg vil blokere den person."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["safety"]},{"id":"item.children.internet.9","order":9,"type":"digital-scenario","speaker":"B","text":{"support":"Demande de l’aide si tu ne trouves pas la fonction.","target":"Bed om hjælp, hvis du ikke kan finde funktionen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["help"]},{"id":"item.children.internet.10","order":10,"type":"dialogue-turn","speaker":"A","text":{"support":"D’accord. Je vais le montrer à un adulte.","target":"Okay. Jeg viser det til en voksen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["safety"]}],"quiz":{"id":"quiz.children.internet","title":{"support":"Mini-quiz — Internet","target":"Miniquiz — Internet"},"questions":[{"id":"q.children.internet.1","order":1,"type":"single-choice","prompt":{"support":"Que ne dois-tu pas donner à quelqu’un en ligne ?","target":"Hvad skal du ikke give til nogen online?"},"answers":[{"id":"a.children.internet.1c","text":{"support":"ton mot de passe","target":"dit kodeord"},"correct":true},{"id":"a.children.internet.1w1","text":{"support":"le nom d’un jeu","target":"navnet på et spil"},"correct":false},{"id":"a.children.internet.1w2","text":{"support":"ta couleur préférée","target":"din yndlingsfarve"},"correct":false}],"explanation":{"support":"Un mot de passe doit rester secret.","target":"Et kodeord skal holdes hemmeligt."},"tags":["privacy"]},{"id":"q.children.internet.2","order":2,"type":"single-choice","prompt":{"support":"Que signifie « Spillet virker ikke » ?","target":"Hvad betyder ‘Spillet virker ikke’?"},"answers":[{"id":"a.children.internet.2c","text":{"support":"Le jeu ne fonctionne pas.","target":"Spillet virker ikke."},"correct":true},{"id":"a.children.internet.2w1","text":{"support":"Le jeu est terminé.","target":"Spillet er slut."},"correct":false},{"id":"a.children.internet.2w2","text":{"support":"Le jeu est nouveau.","target":"Spillet er nyt."},"correct":false}],"explanation":{"support":"« Virker ikke » = ne fonctionne pas.","target":"‘Virker ikke’ betyder, at noget ikke fungerer."},"tags":["problem"]},{"id":"q.children.internet.3","order":3,"type":"single-choice","prompt":{"support":"Que fais-tu si un inconnu te demande des informations privées ?","target":"Hvad gør du, hvis en ukendt spørger om private oplysninger?"},"answers":[{"id":"a.children.internet.3c","text":{"support":"Je ne les donne pas et j’en parle à un adulte.","target":"Jeg giver dem ikke og taler med en voksen."},"correct":true},{"id":"a.children.internet.3w1","text":{"support":"Je donne toujours mon vrai nom.","target":"Jeg giver altid mit rigtige navn."},"correct":false},{"id":"a.children.internet.3w2","text":{"support":"J’envoie mon mot de passe.","target":"Jeg sender mit kodeord."},"correct":false}],"explanation":{"support":"La leçon associe le vocabulaire danois à une règle simple de sécurité numérique.","target":"Lektionen kobler sproget til en enkel regel om digital sikkerhed."},"tags":["safety"]}]}},{"id":"lesson.children.clothes-beach","moduleId":"module.children","order":9,"title":{"support":"Vêtements, plage et météo","target":"Tøj, strand og vejr"},"situation":{"support":"Tu pars à la plage, mais le temps danois change. Tu parles des vêtements, du froid, de la pluie et de ce dont tu as besoin.","target":"Du skal på stranden, men det danske vejr skifter. Du taler om tøj, kulde, regn og om, hvad du har brug for."},"tags":["clothes","beach","weather"],"items":[{"id":"item.children.clothes.1","order":1,"type":"dialogue-turn","speaker":"A","text":{"support":"Il fait froid aujourd’hui ?","target":"Er det koldt i dag?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["weather"]},{"id":"item.children.clothes.2","order":2,"type":"dialogue-turn","speaker":"B","text":{"support":"Un peu, et il y a du vent.","target":"Lidt, og det blæser."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["weather"]},{"id":"item.children.clothes.3","order":3,"type":"dialogue-turn","speaker":"A","text":{"support":"Je prends ma veste.","target":"Jeg tager min jakke med."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["clothes"]},{"id":"item.children.clothes.4","order":4,"type":"dialogue-turn","speaker":"B","text":{"support":"Bonne idée. Il peut pleuvoir plus tard.","target":"God idé. Det kan regne senere."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["weather"]},{"id":"item.children.clothes.5","order":5,"type":"dialogue-turn","speaker":"A","text":{"support":"Où est mon maillot de bain ?","target":"Hvor er mit badetøj?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["clothes"]},{"id":"item.children.clothes.6","order":6,"type":"dialogue-turn","speaker":"B","text":{"support":"Il est dans ton sac.","target":"Det ligger i din taske."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["location"]},{"id":"item.children.clothes.7","order":7,"type":"dialogue-turn","speaker":"A","text":{"support":"L’eau est froide !","target":"Vandet er koldt!"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["beach"]},{"id":"item.children.clothes.8","order":8,"type":"dialogue-turn","speaker":"A","text":{"support":"Je ne veux pas me baigner maintenant.","target":"Jeg vil ikke bade nu."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["choice"]},{"id":"item.children.clothes.9","order":9,"type":"dialogue-turn","speaker":"B","text":{"support":"D’accord. On peut jouer sur la plage à la place.","target":"Okay. Vi kan lege på stranden i stedet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["alternative"]},{"id":"item.children.clothes.10","order":10,"type":"dialogue-turn","speaker":"A","text":{"support":"Oui, j’ai envie de construire un château de sable.","target":"Ja, jeg har lyst til at bygge et sandslot."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["play"]}],"quiz":{"id":"quiz.children.clothes","title":{"support":"Mini-quiz — Plage et météo","target":"Miniquiz — Strand og vejr"},"questions":[{"id":"q.children.clothes.1","order":1,"type":"single-choice","prompt":{"support":"Que signifie « Det blæser » ?","target":"Hvad betyder ‘Det blæser’?"},"answers":[{"id":"a.children.clothes.1c","text":{"support":"Il y a du vent.","target":"Det blæser."},"correct":true},{"id":"a.children.clothes.1w1","text":{"support":"Il neige.","target":"Det sner."},"correct":false},{"id":"a.children.clothes.1w2","text":{"support":"Il fait nuit.","target":"Det er mørkt."},"correct":false}],"explanation":{"support":"« Det blæser » décrit le vent.","target":"‘Det blæser’ betyder, at der er vind."},"tags":["weather"]},{"id":"q.children.clothes.2","order":2,"type":"single-choice","prompt":{"support":"Quel mot signifie « maillot de bain » au sens général ?","target":"Hvilket ord betyder badetøj?"},"answers":[{"id":"a.children.clothes.2c","text":{"support":"maillot/vêtements de bain","target":"badetøj"},"correct":true},{"id":"a.children.clothes.2w1","text":{"support":"veste","target":"jakke"},"correct":false},{"id":"a.children.clothes.2w2","text":{"support":"chaussures","target":"sko"},"correct":false}],"explanation":{"support":"« Badetøj » est un terme général pour les vêtements de bain.","target":"‘Badetøj’ er en samlet betegnelse for tøj til badning."},"tags":["clothes"]},{"id":"q.children.clothes.3","order":3,"type":"single-choice","prompt":{"support":"Que signifie « i stedet » ?","target":"Hvad betyder ‘i stedet’?"},"answers":[{"id":"a.children.clothes.3c","text":{"support":"à la place","target":"i stedet"},"correct":true},{"id":"a.children.clothes.3w1","text":{"support":"tout de suite","target":"med det samme"},"correct":false},{"id":"a.children.clothes.3w2","text":{"support":"ensemble","target":"sammen"},"correct":false}],"explanation":{"support":"« I stedet » introduit une alternative.","target":"‘I stedet’ bruges, når man vælger noget andet."},"tags":["alternative"]}]}},{"id":"lesson.children.emergency","moduleId":"module.children","order":10,"title":{"support":"Quand quelque chose ne va pas","target":"Når noget er galt"},"situation":{"support":"Quelqu’un se blesse ou tu te sens en danger. Tu dois pouvoir appeler un adulte, expliquer simplement le problème et reconnaître qu’une situation peut nécessiter une aide urgente.","target":"Nogen kommer til skade, eller du føler dig utryg. Du skal kunne hente en voksen, forklare problemet enkelt og forstå, at en situation kan kræve akut hjælp."},"tags":["emergency","safety","help"],"items":[{"id":"item.children.emergency.1","order":1,"type":"dialogue-turn","speaker":"A","text":{"support":"Aidez-moi, s’il vous plaît !","target":"Hjælp mig!"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["help"]},{"id":"item.children.emergency.2","order":2,"type":"dialogue-turn","speaker":"B","text":{"support":"Qu’est-ce qui s’est passé ?","target":"Hvad er der sket?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["question"]},{"id":"item.children.emergency.3","order":3,"type":"dialogue-turn","speaker":"A","text":{"support":"Mon ami est tombé.","target":"Min ven er faldet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["accident"]},{"id":"item.children.emergency.4","order":4,"type":"dialogue-turn","speaker":"A","text":{"support":"Il a mal à la jambe.","target":"Han har ondt i benet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Have ondt i … » = avoir mal à …","targetExample":"Han har ondt i benet."}},"tags":["pain"]},{"id":"item.children.emergency.5","order":5,"type":"dialogue-turn","speaker":"B","text":{"support":"Reste avec lui. Je vais chercher de l’aide.","target":"Bliv hos ham. Jeg henter hjælp."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["safety"]},{"id":"item.children.emergency.6","order":6,"type":"dialogue-turn","speaker":"A","text":{"support":"Il saigne.","target":"Han bløder."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["injury"]},{"id":"item.children.emergency.7","order":7,"type":"dialogue-turn","speaker":"B","text":{"support":"Un adulte va décider s’il faut appeler les secours.","target":"En voksen vurderer, om der skal ringes efter akut hjælp."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"cultural":{"support":"Au Danemark, le 112 est le numéro d’urgence pour les situations aiguës nécessitant police, pompiers ou ambulance. Un enfant doit chercher l’aide d’un adulte lorsqu’un adulte est disponible ; en danger immédiat, il doit savoir que le 112 existe."}},"tags":["emergency"]},{"id":"item.children.emergency.8","order":8,"type":"dialogue-turn","speaker":"A","text":{"support":"Où sommes-nous ?","target":"Hvor er vi?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"cultural":{"support":"Pouvoir décrire le lieu est important lorsqu’on demande de l’aide : nom de rue, magasin, gare, parc ou autre point de repère."}},"tags":["location"]},{"id":"item.children.emergency.9","order":9,"type":"dialogue-turn","speaker":"B","text":{"support":"Nous sommes près de l’entrée du parc.","target":"Vi er ved indgangen til parken."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["location"]},{"id":"item.children.emergency.10","order":10,"type":"dialogue-turn","speaker":"A","text":{"support":"D’accord. Je reste ici jusqu’à ce que l’aide arrive.","target":"Okay. Jeg bliver her, til hjælpen kommer."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["safety"]}],"quiz":{"id":"quiz.children.emergency","title":{"support":"Mini-quiz — Aide","target":"Miniquiz — Hjælp"},"questions":[{"id":"q.children.emergency.1","order":1,"type":"single-choice","prompt":{"support":"Comment appelles-tu immédiatement à l’aide ?","target":"Hvordan kalder du hurtigt på hjælp?"},"answers":[{"id":"a.children.emergency.1c","text":{"support":"Aidez-moi !","target":"Hjælp mig!"},"correct":true},{"id":"a.children.emergency.1w1","text":{"support":"Attendez-moi !","target":"Vent på mig!"},"correct":false},{"id":"a.children.emergency.1w2","text":{"support":"Regardez-moi !","target":"Se på mig!"},"correct":false}],"explanation":{"support":"« Hjælp mig! » est court et clair dans une situation urgente.","target":"‘Hjælp mig!’ er en kort og tydelig måde at bede om hjælp."},"tags":["help"]},{"id":"q.children.emergency.2","order":2,"type":"single-choice","prompt":{"support":"Que signifie « Han har ondt i benet » ?","target":"Hvad betyder ‘Han har ondt i benet’?"},"answers":[{"id":"a.children.emergency.2c","text":{"support":"Il a mal à la jambe.","target":"Han har ondt i benet."},"correct":true},{"id":"a.children.emergency.2w1","text":{"support":"Il a froid aux pieds.","target":"Han fryser om fødderne."},"correct":false},{"id":"a.children.emergency.2w2","text":{"support":"Il court vite.","target":"Han løber hurtigt."},"correct":false}],"explanation":{"support":"« Have ondt i » décrit l’endroit où l’on a mal.","target":"‘Have ondt i’ bruges til at fortælle, hvor det gør ondt."},"tags":["pain"]},{"id":"q.children.emergency.3","order":3,"type":"single-choice","prompt":{"support":"Quel est le numéro d’urgence danois pour une situation aiguë ?","target":"Hvad er alarmnummeret i Danmark ved en akut nødsituation?"},"answers":[{"id":"a.children.emergency.3c","text":{"support":"112","target":"112"},"correct":true},{"id":"a.children.emergency.3w1","text":{"support":"911","target":"911"},"correct":false},{"id":"a.children.emergency.3w2","text":{"support":"999","target":"999"},"correct":false}],"explanation":{"support":"Au Danemark, le numéro d’urgence est le 112.","target":"I Danmark er alarmnummeret 112."},"tags":["emergency"]}]}}]}]}}