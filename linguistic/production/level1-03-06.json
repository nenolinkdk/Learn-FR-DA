                "text": { "support": "Nous allons regarder cela tout de suite.", "target": "Vi kigger på det med det samme." },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "cultural": { "support": "Dans le service quotidien, le danois est souvent direct et simple. « Vi kigger på det » signifie qu’on va examiner le problème." }
                },
                "tags": ["service", "problem"]
              }
            ],
