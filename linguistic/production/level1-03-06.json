          {
            "id": "lesson.level-1.cafe",
            "moduleId": "module.level-1",
            "order": 5,
            "title": { "support": "Au café", "target": "På café" },
            "situation": {
              "support": "Vous entrez dans un café avec une autre personne. Vous commandez des boissons et quelque chose à manger, puis vous payez.",
              "target": "Du går ind på en café sammen med en anden. I bestiller drikkevarer og noget at spise og betaler bagefter."
            },
            "tags": ["cafe", "ordering", "payment"],
            "items": [
              {
                "id": "item.level-1.cafe-order",
                "order": 1,
                "type": "dialogue-turn",
                "speaker": "A",
                "text": { "support": "Je voudrais un café, s’il vous plaît.", "target": "Jeg vil gerne have en kaffe, tak." },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "grammar": { "support": "« Jeg vil gerne have … » est une structure très naturelle pour commander. Le danois emploie souvent « tak » à la fin plutôt qu’une traduction littérale de « s’il vous plaît ».", "targetExample": "Jeg vil gerne have en kaffe, tak." },
                  "cultural": { "support": "Le danois n’utilise pas un équivalent direct de « s’il vous plaît » aussi systématiquement que le français. Le ton, « tak » et des structures comme « jeg vil gerne » portent souvent la politesse." }
                },
                "tags": ["ordering", "politeness"]
              },
              {
                "id": "item.level-1.cafe-type",
                "order": 2,
                "type": "dialogue-turn",
                "speaker": "B",
                "text": { "support": "Un café filtre, un americano ou un cappuccino ?", "target": "Filterkaffe, americano eller cappuccino?" },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "tags": ["coffee", "choice"]
              },
              {
                "id": "item.level-1.cafe-cappuccino",
                "order": 3,
                "type": "dialogue-turn",
                "speaker": "A",
                "text": { "support": "Un cappuccino, s’il vous plaît.", "target": "En cappuccino, tak." },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "tags": ["ordering", "coffee"]
