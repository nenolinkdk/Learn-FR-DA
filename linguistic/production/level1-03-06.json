                  "grammar": { "support": "« Hvad er det for en …? » est une structure idiomatique courante pour demander de quel type de chose il s’agit.", "targetExample": "Hvad er det for en kage?" }
                },
                "tags": ["food", "question"]
              },
              {
                "id": "item.level-1.cafe-cinnamon",
                "order": 5,
                "type": "dialogue-turn",
                "speaker": "B",
                "text": { "support": "C’est une brioche à la cannelle.", "target": "Det er en kanelsnegl." },
