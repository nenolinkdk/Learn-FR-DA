          {
            "id": "lesson.level-1.public-transport",
            "moduleId": "module.level-1",
            "order": 3,
            "title": { "support": "Métro, train et bus", "target": "Metro, tog og bus" },
            "situation": {
              "support": "Vous devez rejoindre votre destination en transports publics. Vous vérifiez le billet, le changement et l’arrêt où vous devez descendre.",
              "target": "Du skal frem til din destination med offentlig transport. Du tjekker billet, skift og det stoppested, hvor du skal af."
            },
            "tags": ["transport", "ticket", "journey"],
            "items": [
              {
                "id": "item.level-1.public-transport.ticket-needed",
                "order": 1,
                "type": "dialogue-turn",
                "speaker": "A",
                "text": { "support": "De quel billet est-ce que j’ai besoin ?", "target": "Hvilken billet skal jeg bruge?" },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "grammar": { "support": "« Hvilken » s’emploie ici avec le nom commun de genre commun « billet ».", "targetExample": "Hvilken billet?" }
                },
                "tags": ["ticket", "question"]
              },
              {
                "id": "item.level-1.public-transport.destination",
                "order": 2,
                "type": "dialogue-turn",
                "speaker": "B",
                "text": { "support": "Où allez-vous ?", "target": "Hvor skal du hen?" },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "grammar": { "support": "« Hvor skal du hen? » est une question très courante pour demander la destination.", "targetExample": "Hvor skal du hen?" }
                },
                "tags": ["destination", "question"]
              },
              {
                "id": "item.level-1.public-transport.city-hall",
                "order": 3,
                "type": "dialogue-turn",
                "speaker": "A",
                "text": { "support": "Je vais à Rådhuspladsen.", "target": "Jeg skal til Rådhuspladsen." },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "cultural": { "support": "À Copenhague, « Rådhuspladsen » est la place de l’Hôtel de Ville, pas le bâtiment lui-même. Les noms de lieux servent aussi d’entraînement à l’écoute." },
                  "pronunciation": { "support": "Les noms de lieux danois sont souvent mieux appris comme des unités sonores. Utilisez le TTS plutôt que de déduire la prononciation lettre par lettre.", "targetText": "Rådhuspladsen" }
                },
                "tags": ["destination", "place-name"]
              },
              {
                "id": "item.level-1.public-transport.change",
                "order": 4,
                "type": "dialogue-turn",
                "speaker": "B",
                "text": { "support": "Vous devez changer à Kongens Nytorv.", "target": "Du skal skifte på Kongens Nytorv." },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "grammar": { "support": "« Skifte » signifie changer de ligne, de train, de métro ou de bus selon le contexte.", "targetExample": "Du skal skifte." }
                },
                "tags": ["connection", "modal"]
              },
              {
                "id": "item.level-1.public-transport-which-line",
                "order": 5,
                "type": "dialogue-turn",
                "speaker": "A",
                "text": { "support": "Quelle ligne je dois prendre ensuite ?", "target": "Hvilken linje skal jeg tage bagefter?" },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "grammar": { "support": "« Bagefter » signifie « ensuite/après » dans une séquence d’actions.", "targetExample": "Hvad skal jeg gøre bagefter?" }
                },
                "tags": ["connection", "question"]
              },
              {
                "id": "item.level-1.public-transport-get-off",
                "order": 6,
                "type": "dialogue-turn",
                "speaker": "B",
                "text": { "support": "Descendez au troisième arrêt.", "target": "Stå af ved det tredje stop." },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "grammar": { "support": "« Stå af » est un verbe à particule très courant : descendre d’un moyen de transport.", "targetExample": "Stå af ved næste stop." }
                },
                "tags": ["instructions", "stop"]
              },
              {
                "id": "item.level-1.public-transport-right-bus",
                "order": 7,
                "type": "dialogue-turn",
                "speaker": "A",
                "text": { "support": "Est-ce que c’est le bon bus ?", "target": "Er det den rigtige bus?" },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "grammar": { "support": "« Den rigtige » signifie « le bon/la bonne » avec un nom de genre commun.", "targetExample": "den rigtige bus" }
                },
                "tags": ["confirmation", "bus"]
              },
              {
                "id": "item.level-1.public-transport-app",
                "order": 8,
                "type": "digital-scenario",
                "speaker": "B",
                "text": { "support": "Oui. Vous pouvez aussi suivre le trajet dans l’application.", "target": "Ja. Du kan også følge rejsen i appen." },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "digital": { "support": "Les solutions danoises de transport évoluent. Rejseplanen sert à planifier un trajet ; arrêts et stations se trouvent aussi dans Google Maps, et certains arrêts de bus donnent une information par QR. Pour les billets et le City Pass, consultez les sources officielles : l’app n’indique pas les tarifs ni les horaires. Linguistiquement, reconnaissez « rejse », « billet », « afgang », « spor » et « stop »." }
                },
                "tags": ["digital", "journey-planning"]
              },
              {
                "id": "item.level-1.public-transport-check-in",
                "order": 9,
                "type": "digital-scenario",
                "speaker": "A",
                "text": { "support": "Dois-je valider ou m’enregistrer avant le trajet ?", "target": "Skal jeg checke ind, før jeg rejser?" },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "digital": { "support": "Dans certaines solutions de transport, l’utilisateur doit effectuer une action de check-in/check-out. Les procédures exactes doivent être vérifiées au moment de la publication, car les systèmes peuvent changer." },
                  "grammar": { "support": "Le danois courant utilise aussi le verbe emprunté « checke ind ».", "targetExample": "Skal jeg checke ind?" }
                },
                "tags": ["digital", "ticket"]
              },
              {
                "id": "item.level-1.public-transport-thanks",
                "order": 10,
                "type": "dialogue-turn",
                "speaker": "B",
                "text": { "support": "Oui, et gardez votre billet pendant le trajet.", "target": "Ja, og behold din billet under rejsen." },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "tags": ["instructions", "ticket"]
              }
            ],
            "quiz": {
              "id": "quiz.level-1.public-transport",
              "title": { "support": "Mini-quiz — Transports publics", "target": "Miniquiz — Offentlig transport" },
              "questions": [
                {
                  "id": "question.level-1.public-transport.destination",
                  "order": 1,
                  "type": "single-choice",
                  "prompt": { "support": "Que signifie « Hvor skal du hen? » ?", "target": "Hvad betyder ‘Hvor skal du hen?’?" },
                  "answers": [
                    { "id": "answer.level-1.public-transport.destination.correct", "text": { "support": "Où allez-vous ?", "target": "Hvor skal du hen?" }, "correct": true },
                    { "id": "answer.level-1.public-transport.destination.wrong-1", "text": { "support": "Quel âge avez-vous ?", "target": "Hvor gammel er du?" }, "correct": false },
                    { "id": "answer.level-1.public-transport.destination.wrong-2", "text": { "support": "Où habitez-vous ?", "target": "Hvor bor du?" }, "correct": false }
                  ],
                  "explanation": { "support": "« Hvor skal du hen? » demande la destination.", "target": "‘Hvor skal du hen?’ spørger til destinationen." },
                  "tags": ["destination"]
                },
                {
                  "id": "question.level-1.public-transport-get-off",
                  "order": 2,
                  "type": "single-choice",
                  "prompt": { "support": "Quel verbe signifie « descendre » d’un bus ou d’un train ?", "target": "Hvilket udtryk betyder at forlade en bus eller et tog?" },
                  "answers": [
                    { "id": "answer.level-1.public-transport-get-off.correct", "text": { "support": "descendre", "target": "stå af" }, "correct": true },
                    { "id": "answer.level-1.public-transport-get-off.wrong-1", "text": { "support": "monter", "target": "stå på" }, "correct": false },
                    { "id": "answer.level-1.public-transport-get-off.wrong-2", "text": { "support": "changer", "target": "skifte" }, "correct": false }
                  ],
                  "explanation": { "support": "« Stå af » = descendre ; « stå på » = monter.", "target": "‘Stå af’ betyder at forlade transportmidlet." },
                  "tags": ["transport"]
                },
                {
                  "id": "question.level-1.public-transport-right",
                  "order": 3,
                  "type": "single-choice",
                  "prompt": { "support": "Comment vérifiez-vous que c’est le bon bus ?", "target": "Hvordan spørger man, om det er den rigtige bus?" },
                  "answers": [
                    { "id": "answer.level-1.public-transport-right.correct", "text": { "support": "Est-ce que c’est le bon bus ?", "target": "Er det den rigtige bus?" }, "correct": true },
                    { "id": "answer.level-1.public-transport-right.wrong-1", "text": { "support": "Le bus est en retard.", "target": "Bussen er forsinket." }, "correct": false },
                    { "id": "answer.level-1.public-transport-right.wrong-2", "text": { "support": "Je prends le bus demain.", "target": "Jeg tager bussen i morgen." }, "correct": false }
                  ],
                  "explanation": { "support": "« Den rigtige bus » signifie « le bon bus ».", "target": "‘Den rigtige bus’ betyder den bus, man skal bruge." },
                  "tags": ["confirmation"]
                }
              ]
            }
          },
          {
