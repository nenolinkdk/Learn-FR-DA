                "text": { "support": "Oui, bien sûr. Le départ est avant onze heures.", "target": "Ja, selvfølgelig. Check-out er senest klokken elleve." },
                "tts": { "role": "target", "locale": "da-DK", "enabled": true },
                "notes": {
                  "grammar": { "support": "« Senest » signifie « au plus tard ».", "targetExample": "senest klokken elleve" }
