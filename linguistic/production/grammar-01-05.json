{"schemaVersion":1,"contentVersion":"0.1.0-grammar-01-05","course":{"id":"course.fr-da","courseLocale":"fr-FR","languages":{"support":{"language":"fr","locale":"fr-FR"},"target":{"language":"da","locale":"da-DK"}},"tts":{"primaryRole":"target","targetLocale":"da-DK","supportLocale":"fr-FR"},"title":{"support":"Danois pratique","target":"Praktisk dansk"},"modules":[{"id":"module.grammar","type":"grammar","audience":"general","title":{"support":"Grammaire danoise pratique","target":"Praktisk dansk grammatik"},"tags":["grammar","reference"],"lessons":[{"id":"lesson.grammar.pronouns-present","moduleId":"module.grammar","order":1,"title":{"support":"Pronoms et présent","target":"Pronominer og nutid"},"situation":{"support":"Comprendre les pronoms personnels et la forme simple du présent danois.","target":"Forstå personlige pronominer og den enkle danske nutid."},"tags":["pronouns","present"],"items":[{"id":"item.grammar.pronouns-present.1","order":1,"type":"grammar-example","text":{"support":"Je travaille au Danemark.","target":"Jeg arbejder i Danmark."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Jeg » = je. Au présent, le verbe danois a la même forme pour toutes les personnes.","targetExample":"jeg arbejder"}},"tags":["pronouns","present"]},{"id":"item.grammar.pronouns-present.2","order":2,"type":"grammar-example","text":{"support":"Tu travailles ici.","target":"Du arbejder her."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Du » = tu/vous au singulier courant. Le verbe reste « arbejder ».","targetExample":"du arbejder"}},"tags":["pronouns","present"]},{"id":"item.grammar.pronouns-present.3","order":3,"type":"grammar-example","text":{"support":"Il habite à Aarhus.","target":"Han bor i Aarhus."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Han » = il pour une personne de sexe masculin.","targetExample":"han bor"}},"tags":["pronouns"]},{"id":"item.grammar.pronouns-present.4","order":4,"type":"grammar-example","text":{"support":"Elle parle danois.","target":"Hun taler dansk."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hun » = elle pour une personne de sexe féminin.","targetExample":"hun taler"}},"tags":["pronouns"]},{"id":"item.grammar.pronouns-present.5","order":5,"type":"grammar-example","text":{"support":"Il est ouvert aujourd’hui.","target":"Det er åbent i dag."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Det » peut correspondre à il/ce/cela pour une chose neutre ou une situation.","targetExample":"det er"}},"tags":["pronouns"]},{"id":"item.grammar.pronouns-present.6","order":6,"type":"grammar-example","text":{"support":"Nous prenons le train.","target":"Vi tager toget."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Vi » = nous.","targetExample":"vi tager"}},"tags":["pronouns"]},{"id":"item.grammar.pronouns-present.7","order":7,"type":"grammar-example","text":{"support":"Vous avez une réservation ?","target":"Har I en reservation?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« I » = vous au pluriel. Il s’écrit toujours avec une majuscule.","targetExample":"I har"}},"tags":["pronouns"]},{"id":"item.grammar.pronouns-present.8","order":8,"type":"grammar-example","text":{"support":"Ils arrivent demain.","target":"De kommer i morgen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« De » = ils/elles. Dans l’usage moderne, « De » comme vouvoiement formel est rare.","targetExample":"de kommer"}},"tags":["pronouns"]},{"id":"item.grammar.pronouns-present.9","order":9,"type":"grammar-example","text":{"support":"On utilise souvent une application.","target":"Man bruger ofte en app."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Man » correspond souvent au français « on » lorsqu’on parle en général.","targetExample":"man bruger"}},"tags":["pronouns"]},{"id":"item.grammar.pronouns-present.10","order":10,"type":"grammar-example","text":{"support":"J’apprends le danois.","target":"Jeg lærer dansk."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Beaucoup de verbes réguliers ont un présent en -r : « lære » → « lærer », « arbejde » → « arbejder ».","targetExample":"lære → lærer"}},"tags":["present"]}],"quiz":{"id":"quiz.grammar.pronouns-present","title":{"support":"Mini-quiz — Pronoms et présent","target":"Miniquiz — Pronominer og nutid"},"questions":[{"id":"question.grammar.pronouns-present.1","order":1,"type":"single-choice","prompt":{"support":"Quel pronom signifie « nous » ?","target":"Hvilket pronomen betyder ‘nous’?"},"answers":[{"id":"answer.grammar.pronouns-present.1c","text":{"support":"nous","target":"vi"},"correct":true},{"id":"answer.grammar.pronouns-present.1w1","text":{"support":"ils","target":"de"},"correct":false},{"id":"answer.grammar.pronouns-present.1w2","text":{"support":"tu","target":"du"},"correct":false}],"explanation":{"support":"« Vi » = nous.","target":"‘Vi’ er første person flertal."},"tags":["pronouns"]},{"id":"question.grammar.pronouns-present.2","order":2,"type":"single-choice","prompt":{"support":"Quelle phrase est correcte avec « du » ?","target":"Hvilken sætning er korrekt med ‘du’?"},"answers":[{"id":"answer.grammar.pronouns-present.2c","text":{"support":"Tu travailles ici.","target":"Du arbejder her."},"correct":true},{"id":"answer.grammar.pronouns-present.2w1","text":{"support":"Tu travailles ici.","target":"Du arbejde her."},"correct":false},{"id":"answer.grammar.pronouns-present.2w2","text":{"support":"Tu travailles ici.","target":"Du arbejders her."},"correct":false}],"explanation":{"support":"Le présent est « arbejder ».","target":"Nutidsformen er ‘arbejder’."},"tags":["present"]},{"id":"question.grammar.pronouns-present.3","order":3,"type":"single-choice","prompt":{"support":"Quel pronom danois correspond souvent à « on » ?","target":"Hvilket dansk pronomen svarer ofte til ‘on’?"},"answers":[{"id":"answer.grammar.pronouns-present.3c","text":{"support":"on","target":"man"},"correct":true},{"id":"answer.grammar.pronouns-present.3w1","text":{"support":"nous","target":"vi"},"correct":false},{"id":"answer.grammar.pronouns-present.3w2","text":{"support":"elle","target":"hun"},"correct":false}],"explanation":{"support":"« Man » sert aux affirmations générales.","target":"‘Man’ bruges ofte om mennesker generelt."},"tags":["pronouns"]}]}},{"id":"lesson.grammar.nouns","moduleId":"module.grammar","order":2,"title":{"support":"Noms : en, et et forme définie","target":"Navneord: en, et og bestemt form"},"situation":{"support":"Reconnaître le genre des noms danois et la manière dont l’article défini est ajouté au nom.","target":"Genkende danske navneords køn og hvordan bestemt form sættes på ordet."},"tags":["nouns","definiteness"],"items":[{"id":"item.grammar.nouns.1","order":1,"type":"grammar-example","text":{"support":"un billet","target":"en billet"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"La plupart des noms danois sont de genre commun et prennent « en ».","targetExample":"en billet"}},"tags":["nouns"]},{"id":"item.grammar.nouns.2","order":2,"type":"grammar-example","text":{"support":"un hôtel","target":"et hotel"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Les noms neutres prennent « et ». Le genre doit souvent être appris avec le nom.","targetExample":"et hotel"}},"tags":["nouns"]},{"id":"item.grammar.nouns.3","order":3,"type":"grammar-example","text":{"support":"le billet","target":"billetten"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Pour un nom en « en », l’article défini est normalement ajouté à la fin : billet → billetten.","targetExample":"billet → billetten"}},"tags":["definiteness"]},{"id":"item.grammar.nouns.4","order":4,"type":"grammar-example","text":{"support":"l’hôtel","target":"hotellet"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Pour un nom neutre, la forme définie finit généralement en -et : hotel → hotellet.","targetExample":"hotel → hotellet"}},"tags":["definiteness"]},{"id":"item.grammar.nouns.5","order":5,"type":"grammar-example","text":{"support":"une application","target":"en app"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Les emprunts modernes ont eux aussi un genre grammatical.","targetExample":"en app"}},"tags":["nouns"]},{"id":"item.grammar.nouns.6","order":6,"type":"grammar-example","text":{"support":"le train","target":"toget"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Tog » est neutre : et tog → toget.","targetExample":"et tog → toget"}},"tags":["definiteness"]},{"id":"item.grammar.nouns.7","order":7,"type":"grammar-example","text":{"support":"des billets","target":"billetter"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Le pluriel varie : certains noms prennent -er, d’autres -e ou ne changent pas. Il faut apprendre le pluriel avec le vocabulaire fréquent.","targetExample":"billet → billetter"}},"tags":["plural"]},{"id":"item.grammar.nouns.8","order":8,"type":"grammar-example","text":{"support":"les billets","target":"billetterne"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"La forme définie plurielle prend souvent -ne : billetter → billetterne.","targetExample":"billetter → billetterne"}},"tags":["plural","definiteness"]},{"id":"item.grammar.nouns.9","order":9,"type":"grammar-example","text":{"support":"cette carte","target":"det her kort"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Avec un démonstratif comme « det her », le nom reste généralement sous sa forme indéfinie : « det her kort ».","targetExample":"det her kort"}},"tags":["demonstrative"]},{"id":"item.grammar.nouns.10","order":10,"type":"grammar-example","text":{"support":"ma réservation","target":"min reservation"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Avec un possessif, le nom reste généralement indéfini : « min reservation », pas « min reservationen ».","targetExample":"min reservation"}},"tags":["possessive"]}],"quiz":{"id":"quiz.grammar.nouns","title":{"support":"Mini-quiz — Noms","target":"Miniquiz — Navneord"},"questions":[{"id":"question.grammar.nouns.1","order":1,"type":"single-choice","prompt":{"support":"Quelle est la forme définie de « en billet » ?","target":"Hvad er bestemt form af ‘en billet’?"},"answers":[{"id":"answer.grammar.nouns.1c","text":{"support":"le billet","target":"billetten"},"correct":true},{"id":"answer.grammar.nouns.1w1","text":{"support":"le billet","target":"billetet"},"correct":false},{"id":"answer.grammar.nouns.1w2","text":{"support":"le billet","target":"en billetten"},"correct":false}],"explanation":{"support":"« En » devient ici le suffixe -en.","target":"Bestemt form er ‘billetten’."},"tags":["definiteness"]},{"id":"question.grammar.nouns.2","order":2,"type":"single-choice","prompt":{"support":"Quelle forme est correcte ?","target":"Hvilken form er korrekt?"},"answers":[{"id":"answer.grammar.nouns.2c","text":{"support":"un hôtel","target":"et hotel"},"correct":true},{"id":"answer.grammar.nouns.2w1","text":{"support":"un hôtel","target":"en hotel"},"correct":false},{"id":"answer.grammar.nouns.2w2","text":{"support":"l’hôtel","target":"et hotellet"},"correct":false}],"explanation":{"support":"« Hotel » est neutre : et hotel.","target":"‘Hotel’ er intetkøn: ‘et hotel’."},"tags":["nouns"]},{"id":"question.grammar.nouns.3","order":3,"type":"single-choice","prompt":{"support":"Quelle forme signifie « les billets » ?","target":"Hvilken form betyder ‘les billets’?"},"answers":[{"id":"answer.grammar.nouns.3c","text":{"support":"les billets","target":"billetterne"},"correct":true},{"id":"answer.grammar.nouns.3w1","text":{"support":"des billets","target":"billetter"},"correct":false},{"id":"answer.grammar.nouns.3w2","text":{"support":"le billet","target":"billetten"},"correct":false}],"explanation":{"support":"Le pluriel défini est « billetterne ».","target":"‘Billetterne’ er bestemt flertal."},"tags":["plural"]}]}},{"id":"lesson.grammar.word-order","moduleId":"module.grammar","order":3,"title":{"support":"Ordre des mots et règle V2","target":"Ordstilling og V2-reglen"},"situation":{"support":"Comprendre pourquoi le verbe danois occupe normalement la deuxième position dans une proposition principale.","target":"Forstå hvorfor det danske finitverbum normalt står på anden plads i en hovedsætning."},"tags":["v2","word-order"],"items":[{"id":"item.grammar.word-order.1","order":1,"type":"grammar-example","text":{"support":"Je prends le train aujourd’hui.","target":"Jeg tager toget i dag."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Ordre neutre : sujet + verbe + reste.","targetExample":"Jeg tager toget i dag."}},"tags":["v2"]},{"id":"item.grammar.word-order.2","order":2,"type":"grammar-example","text":{"support":"Aujourd’hui, je prends le train.","target":"I dag tager jeg toget."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Lorsque « I dag » occupe la première position, le verbe « tager » vient en deuxième et le sujet suit.","targetExample":"I dag tager jeg toget."}},"tags":["v2","inversion"]},{"id":"item.grammar.word-order.3","order":3,"type":"grammar-example","text":{"support":"Ensuite, je vais à l’hôtel.","target":"Derefter går jeg til hotellet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Derefter » en tête déclenche également l’inversion.","targetExample":"Derefter går jeg …"}},"tags":["v2"]},{"id":"item.grammar.word-order.4","order":4,"type":"grammar-example","text":{"support":"Demain, nous avons une réunion.","target":"I morgen har vi et møde."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Le groupe temporel est en première position ; le verbe reste deuxième.","targetExample":"I morgen har vi …"}},"tags":["v2"]},{"id":"item.grammar.word-order.5","order":5,"type":"grammar-example","text":{"support":"À Copenhague, je prends le métro.","target":"I København tager jeg metroen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Un complément de lieu peut occuper la première position.","targetExample":"I København tager jeg …"}},"tags":["v2"]},{"id":"item.grammar.word-order.6","order":6,"type":"grammar-example","text":{"support":"Alors, je prends le saumon.","target":"Så tager jeg laksen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Så » est très fréquent en première position dans le danois parlé et écrit.","targetExample":"Så tager jeg …"}},"tags":["v2"]},{"id":"item.grammar.word-order.7","order":7,"type":"grammar-example","text":{"support":"C’est pourquoi je vérifie le billet.","target":"Derfor tjekker jeg billetten."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Derfor » prend la première position ; « tjekker » reste en deuxième.","targetExample":"Derfor tjekker jeg …"}},"tags":["v2"]},{"id":"item.grammar.word-order.8","order":8,"type":"grammar-example","text":{"support":"Je ne comprends pas la lettre.","target":"Jeg forstår ikke brevet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Dans une proposition principale, « ikke » vient généralement après le verbe conjugué. Ce n’est pas une règle universelle : dans une subordonnée, « ikke » précède le verbe (voir la leçon Propositions subordonnées).","targetExample":"Jeg forstår ikke …"}},"tags":["negation","word-order"]},{"id":"item.grammar.word-order.9","order":9,"type":"grammar-example","text":{"support":"Aujourd’hui, je ne travaille pas.","target":"I dag arbejder jeg ikke."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Même avec un élément initial, le verbe reste deuxième ; « ikke » suit ensuite le sujet.","targetExample":"I dag arbejder jeg ikke."}},"tags":["v2","negation"]},{"id":"item.grammar.word-order.10","order":10,"type":"grammar-example","text":{"support":"Avant de partir, je vérifie le billet.","target":"Før jeg tager af sted, tjekker jeg billetten."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Toute la subordonnée initiale occupe la première position de la principale, qui commence donc par « tjekker ».","targetExample":"Før …, tjekker jeg …"}},"tags":["v2","subordinate-clause"]}],"quiz":{"id":"quiz.grammar.word-order","title":{"support":"Mini-quiz — V2","target":"Miniquiz — V2"},"questions":[{"id":"question.grammar.word-order.1","order":1,"type":"single-choice","prompt":{"support":"Quelle phrase est correcte ?","target":"Hvilken sætning er korrekt?"},"answers":[{"id":"answer.grammar.word-order.1c","text":{"support":"Aujourd’hui, je prends le train.","target":"I dag tager jeg toget."},"correct":true},{"id":"answer.grammar.word-order.1w1","text":{"support":"Aujourd’hui, je prends le train.","target":"I dag jeg tager toget."},"correct":false},{"id":"answer.grammar.word-order.1w2","text":{"support":"Aujourd’hui, je prends le train.","target":"I dag toget jeg tager."},"correct":false}],"explanation":{"support":"Le verbe fini doit occuper la deuxième position.","target":"Det finitte verbum står på anden plads."},"tags":["v2"]},{"id":"question.grammar.word-order.2","order":2,"type":"single-choice","prompt":{"support":"Quelle phrase principale place correctement « ikke » ?","target":"Hvilken hovedsætning placerer ‘ikke’ korrekt?"},"answers":[{"id":"answer.grammar.word-order.2c","text":{"support":"Je ne travaille pas aujourd’hui.","target":"Jeg arbejder ikke i dag."},"correct":true},{"id":"answer.grammar.word-order.2w1","text":{"support":"Je ne travaille pas aujourd’hui.","target":"Jeg ikke arbejder i dag."},"correct":false},{"id":"answer.grammar.word-order.2w2","text":{"support":"Je ne travaille pas aujourd’hui.","target":"Ikke jeg arbejder i dag."},"correct":false}],"explanation":{"support":"Dans une principale, « ikke » suit normalement le verbe conjugué. Dans une subordonnée, il précède le verbe.","target":"I en hovedsætning står ‘ikke’ normalt efter det finitte verbum. I en bisætning står det før verbet."},"tags":["negation"]},{"id":"question.grammar.word-order.3","order":3,"type":"single-choice","prompt":{"support":"Que se passe-t-il si « I morgen » vient en premier ?","target":"Hvad sker der, hvis ‘I morgen’ står først?"},"answers":[{"id":"answer.grammar.word-order.3c","text":{"support":"Le verbe vient avant le sujet.","target":"Verbet kommer før subjektet."},"correct":true},{"id":"answer.grammar.word-order.3w1","text":{"support":"Le verbe disparaît.","target":"Verbet forsvinder."},"correct":false},{"id":"answer.grammar.word-order.3w2","text":{"support":"Le sujet reste toujours premier.","target":"Subjektet står altid først."},"correct":false}],"explanation":{"support":"La règle V2 maintient le verbe en deuxième position.","target":"V2-reglen holder verbet på anden plads."},"tags":["v2"]}]}},{"id":"lesson.grammar.questions","moduleId":"module.grammar","order":4,"title":{"support":"Questions","target":"Spørgsmål"},"situation":{"support":"Former les questions oui/non et utiliser les mots interrogatifs les plus fréquents.","target":"Danne ja/nej-spørgsmål og bruge de mest almindelige spørgeord."},"tags":["questions","interrogatives"],"items":[{"id":"item.grammar.questions.1","order":1,"type":"grammar-example","text":{"support":"Vous avez un billet ?","target":"Har du en billet?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Dans une question oui/non, le verbe conjugué vient généralement avant le sujet.","targetExample":"Har du …?"}},"tags":["yes-no-question"]},{"id":"item.grammar.questions.2","order":2,"type":"grammar-example","text":{"support":"Vous pouvez payer par carte ?","target":"Kan du betale med kort?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Avec un modal, le modal vient en premier dans la question.","targetExample":"Kan du …?"}},"tags":["yes-no-question","modal"]},{"id":"item.grammar.questions.3","order":3,"type":"grammar-example","text":{"support":"Où est la gare ?","target":"Hvor er stationen?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hvor » = où.","targetExample":"Hvor er …?"}},"tags":["question-word"]},{"id":"item.grammar.questions.4","order":4,"type":"grammar-example","text":{"support":"Quand part le train ?","target":"Hvornår kører toget?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hvornår » = quand pour demander un moment.","targetExample":"Hvornår …?"}},"tags":["question-word"]},{"id":"item.grammar.questions.5","order":5,"type":"grammar-example","text":{"support":"Comment allez-vous au centre ?","target":"Hvordan kommer du ind til centrum?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hvordan » = comment.","targetExample":"Hvordan …?"}},"tags":["question-word"]},{"id":"item.grammar.questions.6","order":6,"type":"grammar-example","text":{"support":"Que voulez-vous ?","target":"Hvad vil du have?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hvad » = quoi/que.","targetExample":"Hvad …?"}},"tags":["question-word"]},{"id":"item.grammar.questions.7","order":7,"type":"grammar-example","text":{"support":"Qui peut m’aider ?","target":"Hvem kan hjælpe mig?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hvem » = qui.","targetExample":"Hvem …?"}},"tags":["question-word"]},{"id":"item.grammar.questions.8","order":8,"type":"grammar-example","text":{"support":"Quel billet dois-je acheter ?","target":"Hvilken billet skal jeg købe?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hvilken » s’emploie avec un nom de genre commun ; « hvilket » avec un neutre.","targetExample":"hvilken billet / hvilket spor"}},"tags":["question-word"]},{"id":"item.grammar.questions.9","order":9,"type":"grammar-example","text":{"support":"Combien cela coûte ?","target":"Hvor meget koster det?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hvor meget » = combien pour une quantité non comptée ou un prix.","targetExample":"Hvor meget …?"}},"tags":["quantity"]},{"id":"item.grammar.questions.10","order":10,"type":"grammar-example","text":{"support":"Pourquoi le train est-il retardé ?","target":"Hvorfor er toget forsinket?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hvorfor » = pourquoi.","targetExample":"Hvorfor …?"}},"tags":["question-word"]}],"quiz":{"id":"quiz.grammar.questions","title":{"support":"Mini-quiz — Questions","target":"Miniquiz — Spørgsmål"},"questions":[{"id":"question.grammar.questions.1","order":1,"type":"single-choice","prompt":{"support":"Quel mot signifie « où » ?","target":"Hvilket spørgeord betyder ‘où’?"},"answers":[{"id":"answer.grammar.questions.1c","text":{"support":"où","target":"hvor"},"correct":true},{"id":"answer.grammar.questions.1w1","text":{"support":"quand","target":"hvornår"},"correct":false},{"id":"answer.grammar.questions.1w2","text":{"support":"qui","target":"hvem"},"correct":false}],"explanation":{"support":"« Hvor » = où.","target":"‘Hvor’ spørger til sted."},"tags":["question-word"]},{"id":"question.grammar.questions.2","order":2,"type":"single-choice","prompt":{"support":"Quelle question oui/non est correcte ?","target":"Hvilket ja/nej-spørgsmål er korrekt?"},"answers":[{"id":"answer.grammar.questions.2c","text":{"support":"Vous avez un billet ?","target":"Har du en billet?"},"correct":true},{"id":"answer.grammar.questions.2w1","text":{"support":"Vous avez un billet ?","target":"Du har en billet?"},"correct":false},{"id":"answer.grammar.questions.2w2","text":{"support":"Vous avez un billet ?","target":"En billet har du?"},"correct":false}],"explanation":{"support":"Le verbe vient avant le sujet dans la forme neutre de la question.","target":"I et neutralt ja/nej-spørgsmål står verbet før subjektet."},"tags":["yes-no-question"]},{"id":"question.grammar.questions.3","order":3,"type":"single-choice","prompt":{"support":"Quel mot signifie « pourquoi » ?","target":"Hvilket ord betyder ‘pourquoi’?"},"answers":[{"id":"answer.grammar.questions.3c","text":{"support":"pourquoi","target":"hvorfor"},"correct":true},{"id":"answer.grammar.questions.3w1","text":{"support":"comment","target":"hvordan"},"correct":false},{"id":"answer.grammar.questions.3w2","text":{"support":"quoi","target":"hvad"},"correct":false}],"explanation":{"support":"« Hvorfor » demande une raison.","target":"‘Hvorfor’ spørger til årsag."},"tags":["question-word"]}]}},{"id":"lesson.grammar.modals","moduleId":"module.grammar","order":5,"title":{"support":"Verbes modaux","target":"Modalverber"},"situation":{"support":"Utiliser kan, skal, vil, må et bør dans des situations quotidiennes.","target":"Bruge kan, skal, vil, må og bør i hverdagssituationer."},"tags":["modal","verbs"],"items":[{"id":"item.grammar.modals.1","order":1,"type":"grammar-example","text":{"support":"Je peux parler un peu danois.","target":"Jeg kan tale lidt dansk."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Kan » exprime capacité ou possibilité. Le verbe suivant reste à l’infinitif sans « at ».","targetExample":"kan tale"}},"tags":["modal"]},{"id":"item.grammar.modals.2","order":2,"type":"grammar-example","text":{"support":"Je dois acheter un billet.","target":"Jeg skal købe en billet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Skal » exprime souvent nécessité, obligation pratique ou projet prévu.","targetExample":"skal købe"}},"tags":["modal"]},{"id":"item.grammar.modals.3","order":3,"type":"grammar-example","text":{"support":"Je veux rentrer maintenant.","target":"Jeg vil hjem nu."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Vil » exprime la volonté. Avec un mouvement comme « hjem », le verbe lexical peut être omis dans certaines expressions courantes.","targetExample":"Jeg vil hjem."}},"tags":["modal"]},{"id":"item.grammar.modals.4","order":4,"type":"grammar-example","text":{"support":"Je peux entrer ?","target":"Må jeg komme ind?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Må » sert notamment à demander ou donner la permission.","targetExample":"Må jeg …?"}},"tags":["modal","permission"]},{"id":"item.grammar.modals.5","order":5,"type":"grammar-example","text":{"support":"Vous devriez vérifier l’heure.","target":"Du bør tjekke tiden."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Bør » exprime un conseil ou une recommandation.","targetExample":"Du bør …"}},"tags":["modal","advice"]},{"id":"item.grammar.modals.6","order":6,"type":"grammar-example","text":{"support":"Je ne peux pas me connecter.","target":"Jeg kan ikke logge ind."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Avec un modal, « ikke » suit normalement le modal : kan ikke logge ind.","targetExample":"kan ikke logge ind"}},"tags":["modal","negation"]},{"id":"item.grammar.modals.7","order":7,"type":"grammar-example","text":{"support":"Vous n’avez pas besoin de changer de train.","target":"Du behøver ikke at skifte tog."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Behøver ikke » signifie ne pas avoir besoin de. Avec « behøver », « at » est fréquent devant l’infinitif.","targetExample":"behøver ikke at skifte"}},"tags":["modal","negation"]},{"id":"item.grammar.modals.8","order":8,"type":"grammar-example","text":{"support":"Est-ce que je dois réserver ?","target":"Skal jeg bestille?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Dans une question, le modal vient avant le sujet.","targetExample":"Skal jeg …?"}},"tags":["modal","question"]},{"id":"item.grammar.modals.9","order":9,"type":"grammar-example","text":{"support":"Nous pouvons attendre un peu.","target":"Vi kan godt vente lidt."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Godt » avec « kan » indique souvent que quelque chose convient ou est tout à fait possible.","targetExample":"Vi kan godt vente."}},"tags":["modal","particle"]},{"id":"item.grammar.modals.10","order":10,"type":"grammar-example","text":{"support":"Tu peux simplement demander.","target":"Du kan bare spørge."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Bare » peut signifier simplement et rendre la proposition plus naturelle.","targetExample":"Du kan bare spørge."}},"tags":["modal","particle"]}],"quiz":{"id":"quiz.grammar.modals","title":{"support":"Mini-quiz — Modaux","target":"Miniquiz — Modalverber"},"questions":[{"id":"question.grammar.modals.1","order":1,"type":"single-choice","prompt":{"support":"Quel modal sert souvent à demander la permission ?","target":"Hvilket modalverbum bruges ofte til at spørge om lov?"},"answers":[{"id":"answer.grammar.modals.1c","text":{"support":"pouvoir/avoir la permission","target":"må"},"correct":true},{"id":"answer.grammar.modals.1w1","text":{"support":"devoir","target":"skal"},"correct":false},{"id":"answer.grammar.modals.1w2","text":{"support":"vouloir","target":"vil"},"correct":false}],"explanation":{"support":"« Må jeg …? » = puis-je/est-ce que j’ai le droit de … ?","target":"‘Må jeg …?’ bruges til at spørge om tilladelse."},"tags":["permission"]},{"id":"question.grammar.modals.2","order":2,"type":"single-choice","prompt":{"support":"Quelle phrase signifie « Je ne peux pas me connecter » ?","target":"Hvilken sætning betyder ‘Je ne peux pas me connecter’?"},"answers":[{"id":"answer.grammar.modals.2c","text":{"support":"Je ne peux pas me connecter.","target":"Jeg kan ikke logge ind."},"correct":true},{"id":"answer.grammar.modals.2w1","text":{"support":"Je ne veux pas me connecter.","target":"Jeg vil ikke logge ind."},"correct":false},{"id":"answer.grammar.modals.2w2","text":{"support":"Je ne dois pas me connecter.","target":"Jeg skal ikke logge ind."},"correct":false}],"explanation":{"support":"« Kan ikke » = ne pas pouvoir.","target":"‘Kan ikke’ udtrykker manglende mulighed eller evne."},"tags":["modal"]},{"id":"question.grammar.modals.3","order":3,"type":"single-choice","prompt":{"support":"Quel modal exprime souvent un conseil ?","target":"Hvilket modalverbum udtrykker ofte et råd?"},"answers":[{"id":"answer.grammar.modals.3c","text":{"support":"devrait","target":"bør"},"correct":true},{"id":"answer.grammar.modals.3w1","text":{"support":"peut","target":"kan"},"correct":false},{"id":"answer.grammar.modals.3w2","text":{"support":"veut","target":"vil"},"correct":false}],"explanation":{"support":"« Bør » = devrait dans de nombreux conseils.","target":"‘Bør’ bruges ofte til anbefalinger."},"tags":["advice"]}]}}]}]}}
