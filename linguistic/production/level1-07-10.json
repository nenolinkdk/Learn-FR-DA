        {
          "id": "lesson.level-1.travel-problem", "moduleId": "module.level-1", "order": 10,
          "title": { "support": "Un problème pendant le voyage", "target": "Et problem på rejsen" },
          "situation": { "support": "Après une visite, vous constatez que votre sac n’est plus avec vous. Vous expliquez calmement ce qui s’est passé et obtenez les prochaines étapes.", "target": "Efter et besøg opdager du, at din taske ikke længere er hos dig. Du forklarer roligt, hvad der er sket, og får at vide, hvad du skal gøre nu." },
          "tags": ["problem", "lost-property", "help"],
          "items": [
            { "id": "item.level-1.travel-problem-help", "order": 1, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Excusez-moi, j’ai un problème.", "target": "Undskyld, jeg har et problem." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "tags": ["problem", "help"] },
            { "id": "item.level-1.travel-problem-lost", "order": 2, "type": "dialogue-turn", "speaker": "A", "text": { "support": "J’ai perdu mon sac.", "target": "Jeg har mistet min taske." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Har mistet » est le parfait de « miste » : perdre quelque chose.", "targetExample": "Jeg har mistet min taske." } }, "tags": ["perfect", "lost-property"] },
            { "id": "item.level-1.travel-problem-where", "order": 3, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Où l’avez-vous vu pour la dernière fois ?", "target": "Hvor så du den sidst?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "Ici apparaît un passé simple danois très fréquent, « så » (voyait/a vu), utile dans une question concrète sur un événement terminé.", "targetExample": "Hvor så du den sidst?" } }, "tags": ["past", "question"] },
            { "id": "item.level-1.travel-problem-cafe", "order": 4, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Je pense que je l’ai laissée au café.", "target": "Jeg tror, jeg har glemt den på caféen." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Jeg tror, … » introduit ce que l’on pense. « Har glemt » signifie avoir oublié/laissé par oubli.", "targetExample": "Jeg tror, jeg har glemt den." } }, "tags": ["perfect", "lost-property"] },
            { "id": "item.level-1.travel-problem-description", "order": 5, "type": "dialogue-turn", "speaker": "B", "text": { "support": "À quoi ressemble le sac ?", "target": "Hvordan ser tasken ud?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Hvordan ser … ud? » demande l’apparence de quelque chose.", "targetExample": "Hvordan ser tasken ud?" } }, "tags": ["description", "question"] },
            { "id": "item.level-1.travel-problem-black", "order": 6, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Il est noir et assez petit.", "target": "Den er sort og ret lille." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Taske » est un nom de genre commun ; le pronom correspondant est « den ».", "targetExample": "Den er sort." } }, "tags": ["adjectives", "description"] },
            { "id": "item.level-1.travel-problem-phone", "order": 7, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Mon téléphone est dans le sac, mais j’ai ma réservation ici.", "target": "Min telefon er i tasken, men jeg har min reservation her." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "tags": ["possessive", "information"] },
            { "id": "item.level-1.travel-problem-contact", "order": 8, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Donnez-nous votre nom et un numéro où nous pouvons vous joindre.", "target": "Giv os dit navn og et nummer, hvor vi kan kontakte dig." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "cultural": { "support": "Dans une situation réelle, ne donnez des données personnelles qu’au personnel ou service approprié. La leçon enseigne le langage, pas une procédure universelle de déclaration." } }, "tags": ["contact", "instructions"] },
            { "id": "item.level-1.travel-problem-next", "order": 9, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Qu’est-ce que je dois faire maintenant ?", "target": "Hvad skal jeg gøre nu?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Hvad skal jeg gøre nu? » est une phrase générale très utile lorsqu’on a besoin de la prochaine étape.", "targetExample": "Hvad skal jeg gøre nu?" } }, "tags": ["help", "modal"] },
            { "id": "item.level-1.travel-problem-call", "order": 10, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Nous vérifions les objets trouvés et nous vous contactons si nous trouvons le sac.", "target": "Vi tjekker hittegodset og kontakter dig, hvis vi finder tasken." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Hvis » introduit une condition. Dans la subordonnée, « vi finder tasken » suit « hvis ».", "targetExample": "hvis vi finder tasken" }, "cultural": { "support": "« Hittegods » désigne les objets trouvés. Les procédures diffèrent selon le lieu et l’opérateur ; il faut suivre les indications du service concerné." } }, "tags": ["lost-property", "subordinate-clause"] }
          ],
          "quiz": { "id": "quiz.level-1.travel-problem", "title": { "support": "Mini-quiz — Un problème", "target": "Miniquiz — Et problem" }, "questions": [
            { "id": "question.level-1.travel-problem-lost", "order": 1, "type": "single-choice","answerDisplayRole":"target", "prompt": { "support": "Comment dites-vous « J’ai perdu mon sac » ?", "target": "Hvordan siger man ‘J’ai perdu mon sac’?" }, "answers": [{ "id": "answer.level-1.travel-problem-lost.correct", "text": { "support": "J’ai perdu mon sac.", "target": "Jeg har mistet min taske." }, "correct": true }, { "id": "answer.level-1.travel-problem-lost.wrong-1", "text": { "support": "J’achète un sac.", "target": "Jeg køber en taske." }, "correct": false }, { "id": "answer.level-1.travel-problem-lost.wrong-2", "text": { "support": "Mon sac est grand.", "target": "Min taske er stor." }, "correct": false }], "explanation": { "support": "« Har mistet » = a perdu.", "target": "‘Har mistet’ fortæller, at noget er blevet væk." }, "tags": ["lost-property"] },
            { "id": "question.level-1.travel-problem-look", "order": 2, "type": "single-choice","answerDisplayRole":"support", "prompt": { "support": "Que demande « Hvordan ser tasken ud? » ?", "target": "Hvad spørger ‘Hvordan ser tasken ud?’ om?" }, "answers": [{ "id": "answer.level-1.travel-problem-look.correct", "text": { "support": "l’apparence du sac", "target": "hvordan tasken ser ud" }, "correct": true }, { "id": "answer.level-1.travel-problem-look.wrong-1", "text": { "support": "le prix du sac", "target": "hvad tasken koster" }, "correct": false }, { "id": "answer.level-1.travel-problem-look.wrong-2", "text": { "support": "l’endroit où acheter un sac", "target": "hvor man kan købe en taske" }, "correct": false }], "explanation": { "support": "« Hvordan ser … ud? » demande une description visuelle.", "target": "‘Hvordan ser … ud?’ spørger til udseendet." }, "tags": ["description"] },
            { "id": "question.level-1.travel-problem-next", "order": 3, "type": "single-choice","answerDisplayRole":"target", "prompt": { "support": "Comment demande-t-on la prochaine étape ?", "target": "Hvordan spørger man, hvad man skal gøre nu?" }, "answers": [{ "id": "answer.level-1.travel-problem-next.correct", "text": { "support": "Qu’est-ce que je dois faire maintenant ?", "target": "Hvad skal jeg gøre nu?" }, "correct": true }, { "id": "answer.level-1.travel-problem-next.wrong-1", "text": { "support": "Où allez-vous ?", "target": "Hvor skal du hen?" }, "correct": false }, { "id": "answer.level-1.travel-problem-next.wrong-2", "text": { "support": "Quand partez-vous ?", "target": "Hvornår rejser du?" }, "correct": false }], "explanation": { "support": "« Hvad skal jeg gøre nu? » est utile dans de nombreuses situations problématiques.", "target": "Sætningen spørger direkte til næste handling." }, "tags": ["help"] }
          ] }
        }
