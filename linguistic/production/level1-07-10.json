{
  "schemaVersion": 1,
  "contentVersion": "0.1.0-l1-07-10",
  "course": {
    "id": "course.fr-da",
    "courseLocale": "fr-FR",
    "languages": { "support": { "language": "fr", "locale": "fr-FR" }, "target": { "language": "da", "locale": "da-DK" } },
    "tts": { "primaryRole": "target", "targetLocale": "da-DK", "supportLocale": "fr-FR" },
    "title": { "support": "Danois pratique", "target": "Praktisk dansk" },
    "modules": [{
      "id": "module.level-1", "type": "level", "level": 1, "audience": "general",
      "title": { "support": "Niveau 1 — Visiter le Danemark", "target": "Niveau 1 — Besøg i Danmark" },
      "tags": ["travel", "beginner"],
      "lessons": [
        {
          "id": "lesson.level-1.shopping", "moduleId": "module.level-1", "order": 7,
          "title": { "support": "Magasins et paiement", "target": "Butikker og betaling" },
          "situation": { "support": "Vous cherchez un vêtement, vérifiez la taille et le prix, puis passez par une caisse en libre-service et demandez un reçu.", "target": "Du leder efter noget tøj, tjekker størrelse og pris og går derefter gennem en selvbetjeningskasse og spørger efter en kvittering." },
          "tags": ["shopping", "payment", "self-service"],
          "items": [
            { "id": "item.level-1.shopping-find", "order": 1, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Excusez-moi, où sont les vestes ?", "target": "Undskyld, hvor er jakkerne?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Jakkerne » est la forme définie plurielle : les vestes.", "targetExample": "jakke — jakker — jakkerne" } }, "tags": ["shopping", "plural"] },
            { "id": "item.level-1.shopping-over-there", "order": 2, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Elles sont là-bas, à côté des pantalons.", "target": "De er derovre ved siden af bukserne." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Ved siden af » signifie « à côté de ».", "targetExample": "ved siden af" } }, "tags": ["directions", "shopping"] },
            { "id": "item.level-1.shopping-size", "order": 3, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Avez-vous celle-ci dans une taille plus grande ?", "target": "Har I den her i en større størrelse?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Den her » renvoie à un nom de genre commun déjà connu. « Større » est le comparatif de « stor ».", "targetExample": "en større størrelse" } }, "tags": ["size", "demonstrative"] },
            { "id": "item.level-1.shopping-try", "order": 4, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Je peux l’essayer ?", "target": "Må jeg prøve den?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Må jeg …? » demande la permission ; « den » remplace ici la veste.", "targetExample": "Må jeg prøve den?" } }, "tags": ["clothes", "pronoun"] },
            { "id": "item.level-1.shopping-price", "order": 5, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Combien elle coûte ?", "target": "Hvad koster den?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Hvad koster …? » est la question de base pour demander un prix.", "targetExample": "Hvad koster den?" } }, "tags": ["price", "question"] },
            { "id": "item.level-1.shopping-discount", "order": 6, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Elle coûte 600 couronnes, mais il y a 20 % de réduction aujourd’hui.", "target": "Den koster 600 kroner, men der er 20 procent rabat i dag." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "pronunciation": { "support": "Les nombres danois sont un domaine important à travailler séparément. Écoutez le prix comme une unité complète.", "targetText": "600 kroner" } }, "tags": ["price", "numbers"] },
            { "id": "item.level-1.shopping-self-checkout", "order": 7, "type": "digital-scenario", "speaker": "B", "text": { "support": "Vous pouvez payer à la caisse en libre-service.", "target": "Du kan betale ved selvbetjeningskassen." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "digital": { "support": "Les caisses en libre-service sont courantes dans de nombreux magasins danois. « Selvbetjening » signifie libre-service." } }, "tags": ["self-service", "digital"] },
            { "id": "item.level-1.shopping-bag", "order": 8, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Avez-vous besoin d’un sac ?", "target": "Har du brug for en pose?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Har du brug for …? » signifie « avez-vous besoin de …? ».", "targetExample": "Har du brug for en pose?" } }, "tags": ["checkout", "bag"] },
            { "id": "item.level-1.shopping-receipt", "order": 9, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Oui, et je voudrais aussi le reçu.", "target": "Ja, og jeg vil også gerne have kvitteringen." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "digital": { "support": "Un reçu peut être imprimé ou proposé sous forme numérique selon le magasin. « Kvittering » est le mot essentiel à reconnaître." } }, "tags": ["receipt", "payment"] },
            { "id": "item.level-1.shopping-return", "order": 10, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Est-ce que je peux l’échanger si la taille ne convient pas ?", "target": "Kan jeg bytte den, hvis størrelsen ikke passer?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Hvis » introduit une condition : si. « Passer » signifie ici convenir pour la taille.", "targetExample": "hvis størrelsen ikke passer" } }, "tags": ["return", "subordinate-clause"] }
          ],
          "quiz": { "id": "quiz.level-1.shopping", "title": { "support": "Mini-quiz — Magasins", "target": "Miniquiz — Butikker" }, "questions": [
            { "id": "question.level-1.shopping-price", "order": 1, "type": "single-choice","answerDisplayRole":"target", "prompt": { "support": "Comment demande-t-on le prix ?", "target": "Hvordan spørger man om prisen?" }, "answers": [{ "id": "answer.level-1.shopping-price.correct", "text": { "support": "Combien elle coûte ?", "target": "Hvad koster den?" }, "correct": true }, { "id": "answer.level-1.shopping-price.wrong-1", "text": { "support": "Où est-elle ?", "target": "Hvor er den?" }, "correct": false }, { "id": "answer.level-1.shopping-price.wrong-2", "text": { "support": "Elle est grande.", "target": "Den er stor." }, "correct": false }], "explanation": { "support": "« Hvad koster …? » demande le prix.", "target": "‘Hvad koster …?’ bruges til at spørge om pris." }, "tags": ["price"] },
            { "id": "question.level-1.shopping-receipt", "order": 2, "type": "single-choice","answerDisplayRole":"target", "prompt": { "support": "Quel mot signifie « reçu » ?", "target": "Hvilket ord betyder ‘reçu’?" }, "answers": [{ "id": "answer.level-1.shopping-receipt.correct", "text": { "support": "reçu", "target": "kvittering" }, "correct": true }, { "id": "answer.level-1.shopping-receipt.wrong-1", "text": { "support": "sac", "target": "pose" }, "correct": false }, { "id": "answer.level-1.shopping-receipt.wrong-2", "text": { "support": "taille", "target": "størrelse" }, "correct": false }], "explanation": { "support": "« Kvittering » = reçu/preuve d’achat.", "target": "En kvittering dokumenterer et køb." }, "tags": ["receipt"] },
            { "id": "question.level-1.shopping-size", "order": 3, "type": "single-choice","answerDisplayRole":"support", "prompt": { "support": "Que signifie « en større størrelse » ?", "target": "Hvad betyder ‘en større størrelse’?" }, "answers": [{ "id": "answer.level-1.shopping-size.correct", "text": { "support": "une taille plus grande", "target": "en større størrelse" }, "correct": true }, { "id": "answer.level-1.shopping-size.wrong-1", "text": { "support": "une autre couleur", "target": "en anden farve" }, "correct": false }, { "id": "answer.level-1.shopping-size.wrong-2", "text": { "support": "un prix plus bas", "target": "en lavere pris" }, "correct": false }], "explanation": { "support": "« Større » est le comparatif de « stor ».", "target": "‘Større’ er komparativ af ‘stor’." }, "tags": ["size"] }
          ] }
        },
        {
          "id": "lesson.level-1.directions", "moduleId": "module.level-1", "order": 8,
          "title": { "support": "Se repérer et visiter", "target": "Find vej og oplev byen" },
          "situation": { "support": "Vous êtes à pied dans le centre-ville. Vous cherchez un musée, demandez le chemin et vérifiez que vous avez compris l’itinéraire.", "target": "Du går rundt i centrum. Du leder efter et museum, spørger om vej og tjekker, at du har forstået ruten." },
          "tags": ["directions", "sightseeing", "walking"],
          "items": [
            { "id": "item.level-1.directions-museum", "order": 1, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Excusez-moi, où se trouve le musée ?", "target": "Undskyld, hvor ligger museet?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "Pour un lieu fixe, « Hvor ligger …? » est souvent plus idiomatique que simplement « Hvor er …? ».", "targetExample": "Hvor ligger museet?" } }, "tags": ["directions", "question"] },
            { "id": "item.level-1.directions-straight", "order": 2, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Continuez tout droit jusqu’au feu.", "target": "Fortsæt ligeud til lyskrydset." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Fortsæt » est un impératif : continuez. « Lyskryds » désigne une intersection avec feux de circulation.", "targetExample": "Fortsæt ligeud." } }, "tags": ["instructions", "directions"] },
            { "id": "item.level-1.directions-left", "order": 3, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Tournez ensuite à gauche.", "target": "Drej derefter til venstre." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "tags": ["directions", "instructions"] },
            { "id": "item.level-1.directions-far", "order": 4, "type": "dialogue-turn", "speaker": "A", "text": { "support": "C’est loin d’ici ?", "target": "Er der langt herfra?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Er der langt …? » est une manière naturelle de demander si la distance est grande.", "targetExample": "Er der langt herfra?" } }, "tags": ["distance", "question"] },
            { "id": "item.level-1.directions-minutes", "order": 5, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Non, environ cinq minutes à pied.", "target": "Nej, cirka fem minutter til fods." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Til fods » signifie à pied.", "targetExample": "fem minutter til fods" } }, "tags": ["distance", "time"] },
            { "id": "item.level-1.directions-bridge", "order": 6, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Je dois traverser le pont ?", "target": "Skal jeg over broen?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "Le danois courant peut dire simplement « over broen » pour traverser/passer par-dessus le pont.", "targetExample": "Skal jeg over broen?" } }, "tags": ["directions", "question"] },
            { "id": "item.level-1.directions-before", "order": 7, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Non, le musée est juste avant le pont.", "target": "Nej, museet ligger lige før broen." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "tags": ["directions", "location"] },
            { "id": "item.level-1.directions-map", "order": 8, "type": "digital-scenario", "speaker": "A", "text": { "support": "Je peux aussi le trouver sur la carte de mon téléphone.", "target": "Jeg kan også finde det på kortet på min telefon." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "digital": { "support": "Les cartes numériques sont utiles, mais il reste important de comprendre des indications simples comme « ligeud », « til venstre », « til højre », « før » et « efter »." } }, "tags": ["maps", "digital"] },
            { "id": "item.level-1.directions-right-way", "order": 9, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Donc, je vais tout droit et je tourne à gauche au feu ?", "target": "Så går jeg ligeud og drejer til venstre ved lyskrydset?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "Après « så » placé en tête, le verbe vient avant le sujet : « Så går jeg … ».", "targetExample": "Så går jeg ligeud." } }, "tags": ["v2", "confirmation"] },
            { "id": "item.level-1.directions-correct", "order": 10, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Exactement. Vous le verrez sur votre droite.", "target": "Præcis. Du kan se det på højre hånd." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "tags": ["confirmation", "directions"] }
          ],
          "quiz": { "id": "quiz.level-1.directions", "title": { "support": "Mini-quiz — Se repérer", "target": "Miniquiz — Find vej" }, "questions": [
            { "id": "question.level-1.directions-left", "order": 1, "type": "single-choice","answerDisplayRole":"support", "prompt": { "support": "Que signifie « til venstre » ?", "target": "Hvad betyder ‘til venstre’?" }, "answers": [{ "id": "answer.level-1.directions-left.correct", "text": { "support": "à gauche", "target": "til venstre" }, "correct": true }, { "id": "answer.level-1.directions-left.wrong-1", "text": { "support": "à droite", "target": "til højre" }, "correct": false }, { "id": "answer.level-1.directions-left.wrong-2", "text": { "support": "tout droit", "target": "ligeud" }, "correct": false }], "explanation": { "support": "« Venstre » = gauche ; « højre » = droite.", "target": "‘Venstre’ og ‘højre’ angiver retning." }, "tags": ["directions"] },
            { "id": "question.level-1.directions-far", "order": 2, "type": "single-choice","answerDisplayRole":"target", "prompt": { "support": "Comment demande-t-on si c’est loin ?", "target": "Hvordan spørger man, om der er langt?" }, "answers": [{ "id": "answer.level-1.directions-far.correct", "text": { "support": "C’est loin d’ici ?", "target": "Er der langt herfra?" }, "correct": true }, { "id": "answer.level-1.directions-far.wrong-1", "text": { "support": "C’est ouvert ?", "target": "Er der åbent?" }, "correct": false }, { "id": "answer.level-1.directions-far.wrong-2", "text": { "support": "C’est cher ?", "target": "Er det dyrt?" }, "correct": false }], "explanation": { "support": "« Langt » exprime une grande distance.", "target": "‘Langt’ handler om afstand." }, "tags": ["distance"] },
            { "id": "question.level-1.directions-walk", "order": 3, "type": "single-choice","answerDisplayRole":"support", "prompt": { "support": "Que signifie « til fods » ?", "target": "Hvad betyder ‘til fods’?" }, "answers": [{ "id": "answer.level-1.directions-walk.correct", "text": { "support": "à pied", "target": "til fods" }, "correct": true }, { "id": "answer.level-1.directions-walk.wrong-1", "text": { "support": "en bus", "target": "med bus" }, "correct": false }, { "id": "answer.level-1.directions-walk.wrong-2", "text": { "support": "à vélo", "target": "på cykel" }, "correct": false }], "explanation": { "support": "« Til fods » signifie se déplacer à pied.", "target": "‘Til fods’ betyder, at man går." }, "tags": ["walking"] }
          ] }
        },
        {
          "id": "lesson.level-1.digital-booking", "moduleId": "module.level-1", "order": 9,
          "title": { "support": "Billets, applications et réservations", "target": "Billetter, apps og reservationer" },
          "situation": { "support": "Vous avez réservé une visite pour l’après-midi. À l’entrée, vous devez retrouver la réservation et afficher le billet numérique.", "target": "Du har bestilt et besøg til om eftermiddagen. Ved indgangen skal du finde reservationen og vise den digitale billet." },
          "tags": ["booking", "digital", "ticket"],
          "items": [
            { "id": "item.level-1.digital-booking-necessary", "order": 1, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Faut-il réserver à l’avance ?", "target": "Skal man bestille på forhånd?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Man » correspond souvent au français « on ». « På forhånd » signifie à l’avance.", "targetExample": "Skal man bestille på forhånd?" } }, "tags": ["booking", "man"] },
            { "id": "item.level-1.digital-booking-recommended", "order": 2, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Ce n’est pas obligatoire, mais c’est une bonne idée.", "target": "Det er ikke nødvendigt, men det er en god idé." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Ikke » suit le verbe conjugué dans cette phrase principale : « Det er ikke … ».", "targetExample": "Det er ikke nødvendigt." } }, "tags": ["negation", "booking"] },
            { "id": "item.level-1.digital-booking-have", "order": 3, "type": "dialogue-turn", "speaker": "A", "text": { "support": "J’ai déjà réservé deux billets.", "target": "Jeg har allerede bestilt to billetter." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "Premier usage pratique du parfait : « har bestilt » = ai réservé/commandé.", "targetExample": "Jeg har bestilt to billetter." } }, "tags": ["perfect", "ticket"] },
            { "id": "item.level-1.digital-booking-show", "order": 4, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Pouvez-vous montrer le billet sur votre téléphone ?", "target": "Kan du vise billetten på din telefon?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "tags": ["ticket", "phone"] },
            { "id": "item.level-1.digital-booking-email", "order": 5, "type": "digital-scenario", "speaker": "A", "text": { "support": "Un instant. Je cherche l’e-mail de confirmation.", "target": "Et øjeblik. Jeg leder efter bekræftelsesmailen." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "digital": { "support": "Les billets et réservations peuvent se trouver dans un e-mail, un SMS, un portefeuille numérique ou une application. Le vocabulaire reste utile même si le canal change." } }, "tags": ["email", "digital"] },
            { "id": "item.level-1.digital-booking-qr", "order": 6, "type": "digital-scenario", "speaker": "B", "text": { "support": "Ouvrez le code QR, s’il vous plaît.", "target": "Åbn QR-koden, tak." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Åbn » est l’impératif de « åbne » : ouvrir.", "targetExample": "Åbn QR-koden." } }, "tags": ["qr", "instructions"] },
            { "id": "item.level-1.digital-booking-not-load", "order": 7, "type": "digital-scenario", "speaker": "A", "text": { "support": "Il ne s’affiche pas. Qu’est-ce que je dois faire ?", "target": "Den kommer ikke frem. Hvad skal jeg gøre?" }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "grammar": { "support": "« Hvad skal jeg gøre? » est une question pratique très générale : que dois-je faire ?", "targetExample": "Hvad skal jeg gøre?" } }, "tags": ["problem", "digital"] },
            { "id": "item.level-1.digital-booking-name", "order": 8, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Je peux chercher la réservation avec votre nom.", "target": "Jeg kan finde reservationen på dit navn." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "tags": ["reservation", "service"] },
            { "id": "item.level-1.digital-booking-time", "order": 9, "type": "dialogue-turn", "speaker": "B", "text": { "support": "Votre créneau commence à 14 h 30.", "target": "Jeres tid begynder klokken 14.30." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "notes": { "cultural": { "support": "Pour les réservations, « tid » peut désigner l’heure/le créneau attribué. Les horaires danois utilisent couramment le format 24 heures à l’écrit." } }, "tags": ["time", "booking"] },
            { "id": "item.level-1.digital-booking-ready", "order": 10, "type": "dialogue-turn", "speaker": "A", "text": { "support": "Parfait, maintenant j’ai le billet à l’écran.", "target": "Perfekt, nu har jeg billetten på skærmen." }, "tts": { "role": "target", "locale": "da-DK", "enabled": true }, "tags": ["ticket", "digital"] }
          ],
          "quiz": { "id": "quiz.level-1.digital-booking", "title": { "support": "Mini-quiz — Réservations", "target": "Miniquiz — Reservationer" }, "questions": [
            { "id": "question.level-1.digital-booking-perfect", "order": 1, "type": "single-choice","answerDisplayRole":"support", "prompt": { "support": "Que signifie « Jeg har bestilt to billetter » ?", "target": "Hvad betyder ‘Jeg har bestilt to billetter’?" }, "answers": [{ "id": "answer.level-1.digital-booking-perfect.correct", "text": { "support": "J’ai réservé deux billets.", "target": "Jeg har bestilt to billetter." }, "correct": true }, { "id": "answer.level-1.digital-booking-perfect.wrong-1", "text": { "support": "Je cherche deux billets.", "target": "Jeg leder efter to billetter." }, "correct": false }, { "id": "answer.level-1.digital-booking-perfect.wrong-2", "text": { "support": "Je paie deux billets.", "target": "Jeg betaler for to billetter." }, "correct": false }], "explanation": { "support": "« Har bestilt » est un parfait : a réservé/commandé.", "target": "‘Har bestilt’ er førnutid." }, "tags": ["perfect"] },
            { "id": "question.level-1.digital-booking-qr", "order": 2, "type": "single-choice","answerDisplayRole":"support", "prompt": { "support": "Que signifie « Åbn QR-koden » ?", "target": "Hvad betyder ‘Åbn QR-koden’?" }, "answers": [{ "id": "answer.level-1.digital-booking-qr.correct", "text": { "support": "Ouvrez le code QR.", "target": "Åbn QR-koden." }, "correct": true }, { "id": "answer.level-1.digital-booking-qr.wrong-1", "text": { "support": "Fermez l’application.", "target": "Luk appen." }, "correct": false }, { "id": "answer.level-1.digital-booking-qr.wrong-2", "text": { "support": "Achetez un billet.", "target": "Køb en billet." }, "correct": false }], "explanation": { "support": "« Åbn » = ouvrez.", "target": "‘Åbn’ er bydeform af ‘åbne’." }, "tags": ["instructions"] },
            { "id": "question.level-1.digital-booking-advance", "order": 3, "type": "single-choice","answerDisplayRole":"support", "prompt": { "support": "Que signifie « på forhånd » ?", "target": "Hvad betyder ‘på forhånd’?" }, "answers": [{ "id": "answer.level-1.digital-booking-advance.correct", "text": { "support": "à l’avance", "target": "på forhånd" }, "correct": true }, { "id": "answer.level-1.digital-booking-advance.wrong-1", "text": { "support": "en retard", "target": "forsinket" }, "correct": false }, { "id": "answer.level-1.digital-booking-advance.wrong-2", "text": { "support": "sur place", "target": "på stedet" }, "correct": false }], "explanation": { "support": "« På forhånd » signifie avant le moment prévu.", "target": "‘På forhånd’ betyder, at noget gøres inden." }, "tags": ["booking"] }
