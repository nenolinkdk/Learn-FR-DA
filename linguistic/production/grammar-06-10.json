{"schemaVersion":1,"contentVersion":"0.1.0-grammar-06-10","course":{"id":"course.fr-da","courseLocale":"fr-FR","languages":{"support":{"language":"fr","locale":"fr-FR"},"target":{"language":"da","locale":"da-DK"}},"tts":{"primaryRole":"target","targetLocale":"da-DK","supportLocale":"fr-FR"},"title":{"support":"Danois pratique","target":"Praktisk dansk"},"modules":[{"id":"module.grammar","type":"grammar","audience":"general","title":{"support":"Grammaire danoise pratique","target":"Praktisk dansk grammatik"},"tags":["grammar","reference"],"lessons":[{"id":"lesson.grammar.past-perfect","moduleId":"module.grammar","order":6,"title":{"support":"Passé et parfait","target":"Datid og førnutid"},"situation":{"support":"Parler de ce qui s’est passé et de ce qui a déjà été fait.","target":"Tale om hvad der skete, og hvad der allerede er blevet gjort."},"tags":["past","perfect"],"items":[{"id":"item.grammar.past-perfect.1","order":1,"type":"grammar-example","text":{"support":"Je travaillais hier.","target":"Jeg arbejdede i går."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Beaucoup de verbes réguliers forment le passé en -ede : arbejder → arbejdede.","targetExample":"arbejder → arbejdede"}},"tags":["past"]},{"id":"item.grammar.past-perfect.2","order":2,"type":"grammar-example","text":{"support":"J’ai acheté un billet hier.","target":"Jeg købte en billet i går."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Købe » a le passé irrégulier « købte ».","targetExample":"købe → købte"}},"tags":["past"]},{"id":"item.grammar.past-perfect.3","order":3,"type":"grammar-example","text":{"support":"Nous sommes arrivés tard.","target":"Vi kom sent."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Kom » est le passé irrégulier de « komme ».","targetExample":"komme → kom"}},"tags":["past"]},{"id":"item.grammar.past-perfect.4","order":4,"type":"grammar-example","text":{"support":"J’ai déjà payé.","target":"Jeg har allerede betalt."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Le parfait se forme souvent avec « har » + participe passé.","targetExample":"har betalt"}},"tags":["perfect"]},{"id":"item.grammar.past-perfect.5","order":5,"type":"grammar-example","text":{"support":"J’ai reçu une lettre.","target":"Jeg har fået et brev."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Få » a le participe « fået ».","targetExample":"få → har fået"}},"tags":["perfect"]},{"id":"item.grammar.past-perfect.6","order":6,"type":"grammar-example","text":{"support":"Nous avons réservé une table.","target":"Vi har bestilt et bord."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Le parfait relie souvent une action passée à la situation présente.","targetExample":"har bestilt"}},"tags":["perfect"]},{"id":"item.grammar.past-perfect.7","order":7,"type":"grammar-example","text":{"support":"Je n’ai pas encore reçu la carte.","target":"Jeg har ikke fået kortet endnu."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Dans le parfait, « ikke » vient après l’auxiliaire « har » ; « endnu » correspond ici à encore/pas encore.","targetExample":"har ikke fået … endnu"}},"tags":["perfect","negation"]},{"id":"item.grammar.past-perfect.8","order":8,"type":"grammar-example","text":{"support":"Avez-vous déjà essayé l’application ?","target":"Har du prøvet appen før?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Le parfait est fréquent pour demander une expérience antérieure.","targetExample":"Har du prøvet … før?"}},"tags":["perfect","question"]},{"id":"item.grammar.past-perfect.9","order":9,"type":"grammar-example","text":{"support":"Hier, le train était retardé.","target":"I går var toget forsinket."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Var » est le passé de « være ».","targetExample":"være → var"}},"tags":["past"]},{"id":"item.grammar.past-perfect.10","order":10,"type":"grammar-example","text":{"support":"J’étais au travail toute la journée.","target":"Jeg var på arbejde hele dagen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Un repère passé terminé comme « i går » favorise souvent le prétérit ; le parfait est fréquent lorsque le résultat ou l’expérience reste pertinent.","targetExample":"Jeg var … / Jeg har været …"}},"tags":["past","perfect"]}],"quiz":{"id":"quiz.grammar.past-perfect","title":{"support":"Mini-quiz — Passé","target":"Miniquiz — Datid"},"questions":[{"id":"question.grammar.past-perfect.1","order":1,"type":"single-choice","prompt":{"support":"Quel est le passé de « være » ?","target":"Hvad er datid af ‘være’?"},"answers":[{"id":"answer.grammar.past-perfect.1c","text":{"support":"était","target":"var"},"correct":true},{"id":"answer.grammar.past-perfect.1w1","text":{"support":"est","target":"er"},"correct":false},{"id":"answer.grammar.past-perfect.1w2","text":{"support":"sera","target":"bliver"},"correct":false}],"explanation":{"support":"« Være » → « var » au passé.","target":"Datid af ‘være’ er ‘var’."},"tags":["past"]},{"id":"question.grammar.past-perfect.2","order":2,"type":"single-choice","prompt":{"support":"Quelle phrase est au parfait ?","target":"Hvilken sætning står i førnutid?"},"answers":[{"id":"answer.grammar.past-perfect.2c","text":{"support":"J’ai déjà payé.","target":"Jeg har allerede betalt."},"correct":true},{"id":"answer.grammar.past-perfect.2w1","text":{"support":"Je paie maintenant.","target":"Jeg betaler nu."},"correct":false},{"id":"answer.grammar.past-perfect.2w2","text":{"support":"J’ai payé hier.","target":"Jeg betalte i går."},"correct":false}],"explanation":{"support":"« Har » + participe forme ici le parfait.","target":"‘Har’ + kort tillægsform danner her førnutid."},"tags":["perfect"]},{"id":"question.grammar.past-perfect.3","order":3,"type":"single-choice","prompt":{"support":"Quelle forme signifie « je n’ai pas encore reçu » ?","target":"Hvilken form betyder ‘je n’ai pas encore reçu’?"},"answers":[{"id":"answer.grammar.past-perfect.3c","text":{"support":"Je n’ai pas encore reçu.","target":"Jeg har ikke fået endnu."},"correct":true},{"id":"answer.grammar.past-perfect.3w1","text":{"support":"Je ne reçois pas.","target":"Jeg får ikke."},"correct":false},{"id":"answer.grammar.past-perfect.3w2","text":{"support":"Je n’ai pas reçu hier.","target":"Jeg fik ikke i går."},"correct":false}],"explanation":{"support":"« Har ikke fået … endnu » exprime « ne pas encore avoir reçu ».","target":"‘Har ikke fået … endnu’ er førnutid med nægtelse."},"tags":["perfect"]}]}},{"id":"lesson.grammar.subordinate","moduleId":"module.grammar","order":7,"title":{"support":"Propositions subordonnées","target":"Ledsætninger"},"situation":{"support":"Reconnaître at, hvis, når, fordi et om et placer correctement la négation.","target":"Genkende at, hvis, når, fordi og om og placere nægtelsen korrekt."},"tags":["subordinate-clause","word-order"],"items":[{"id":"item.grammar.subordinate.1","order":1,"type":"grammar-example","text":{"support":"Je pense que le train arrive bientôt.","target":"Jeg tror, at toget kommer snart."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« At » introduit souvent une proposition complétive : que.","targetExample":"at toget kommer"}},"tags":["subordinate-clause"]},{"id":"item.grammar.subordinate.2","order":2,"type":"grammar-example","text":{"support":"Je pense que le train n’arrive pas aujourd’hui.","target":"Jeg tror, at toget ikke kommer i dag."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Dans une subordonnée, « ikke » précède le verbe conjugué : at toget ikke kommer. Même place avec fordi, hvis, når et som. Ne pas confondre avec la principale « Jeg tror ikke, at toget kommer i dag », où « ikke » nie « tror ».","targetExample":"at toget ikke kommer"}},"tags":["subordinate-clause","negation"]},{"id":"item.grammar.subordinate.3","order":3,"type":"grammar-example","text":{"support":"Si vous avez MitID, vous pouvez vous connecter.","target":"Hvis du har MitID, kan du logge ind."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hvis » = si pour une condition. Après la subordonnée initiale, la principale suit la règle V2 : kan du.","targetExample":"Hvis …, kan du …"}},"tags":["condition","v2"]},{"id":"item.grammar.subordinate.4","order":4,"type":"grammar-example","text":{"support":"Quand j’arrive, je vous appelle.","target":"Når jeg kommer, ringer jeg til dig."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Når » sert notamment pour quand dans une situation future ou répétée.","targetExample":"Når jeg kommer …"}},"tags":["time-clause"]},{"id":"item.grammar.subordinate.5","order":5,"type":"grammar-example","text":{"support":"Je reste ici parce que j’attends quelqu’un.","target":"Jeg bliver her, fordi jeg venter på nogen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Fordi » = parce que.","targetExample":"fordi jeg venter"}},"tags":["reason"]},{"id":"item.grammar.subordinate.6","order":6,"type":"grammar-example","text":{"support":"Je ne sais pas si le magasin est ouvert.","target":"Jeg ved ikke, om butikken er åben."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Om » introduit une question indirecte oui/non : si.","targetExample":"om butikken er åben"}},"tags":["indirect-question"]},{"id":"item.grammar.subordinate.7","order":7,"type":"grammar-example","text":{"support":"Avant de partir, je vérifie l’application.","target":"Før jeg tager af sted, tjekker jeg appen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Før » = avant que/avant de dans cette structure.","targetExample":"Før jeg tager af sted …"}},"tags":["time-clause"]},{"id":"item.grammar.subordinate.8","order":8,"type":"grammar-example","text":{"support":"Même si je ne comprends pas tout, j’essaie.","target":"Selvom jeg ikke forstår alt, prøver jeg."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Selvom » = même si/bien que. Notez « jeg ikke forstår » dans la subordonnée.","targetExample":"selvom jeg ikke forstår"}},"tags":["subordinate-clause","negation"]},{"id":"item.grammar.subordinate.9","order":9,"type":"grammar-example","text":{"support":"Elle dit qu’elle travaille demain.","target":"Hun siger, at hun arbejder i morgen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Le danois utilise souvent le présent avec un repère futur explicite.","targetExample":"arbejder i morgen"}},"tags":["subordinate-clause","present"]},{"id":"item.grammar.subordinate.10","order":10,"type":"grammar-example","text":{"support":"Si je ne peux pas payer, je demande de l’aide.","target":"Hvis jeg ikke kan betale, beder jeg om hjælp."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Dans « hvis jeg ikke kan », la négation précède le modal dans la subordonnée.","targetExample":"hvis jeg ikke kan"}},"tags":["condition","negation"]}],"quiz":{"id":"quiz.grammar.subordinate","title":{"support":"Mini-quiz — Subordonnées","target":"Miniquiz — Ledsætninger"},"questions":[{"id":"question.grammar.subordinate.1","order":1,"type":"single-choice","prompt":{"support":"Quelle phrase a l’ordre correct dans la subordonnée ?","target":"Hvilken sætning har korrekt ordstilling i ledsætningen?"},"answers":[{"id":"answer.grammar.subordinate.1c","text":{"support":"Je pense que le train ne vient pas.","target":"Jeg tror, at toget ikke kommer."},"correct":true},{"id":"answer.grammar.subordinate.1w1","text":{"support":"Je pense que le train ne vient pas.","target":"Jeg tror, at toget kommer ikke."},"correct":false},{"id":"answer.grammar.subordinate.1w2","text":{"support":"Je pense que le train ne vient pas.","target":"Jeg tror, ikke toget kommer."},"correct":false}],"explanation":{"support":"Dans la subordonnée, « ikke » précède le verbe conjugué.","target":"I ledsætningen står ‘ikke’ før det finitte verbum."},"tags":["negation"]},{"id":"question.grammar.subordinate.2","order":2,"type":"single-choice","prompt":{"support":"Quel mot introduit souvent une condition ?","target":"Hvilket ord indleder ofte en betingelse?"},"answers":[{"id":"answer.grammar.subordinate.2c","text":{"support":"si","target":"hvis"},"correct":true},{"id":"answer.grammar.subordinate.2w1","text":{"support":"parce que","target":"fordi"},"correct":false},{"id":"answer.grammar.subordinate.2w2","text":{"support":"que","target":"at"},"correct":false}],"explanation":{"support":"« Hvis » = si conditionnel.","target":"‘Hvis’ indleder en betingelse."},"tags":["condition"]},{"id":"question.grammar.subordinate.3","order":3,"type":"single-choice","prompt":{"support":"Quel mot utilise-t-on souvent pour une question indirecte oui/non ?","target":"Hvilket ord bruges ofte i et indirekte ja/nej-spørgsmål?"},"answers":[{"id":"answer.grammar.subordinate.3c","text":{"support":"si","target":"om"},"correct":true},{"id":"answer.grammar.subordinate.3w1","text":{"support":"quand","target":"når"},"correct":false},{"id":"answer.grammar.subordinate.3w2","text":{"support":"pourquoi","target":"hvorfor"},"correct":false}],"explanation":{"support":"« Jeg ved ikke, om … » = je ne sais pas si …","target":"‘Om’ bruges her til et indirekte spørgsmål."},"tags":["indirect-question"]}]}},{"id":"lesson.grammar.prepositions","moduleId":"module.grammar","order":8,"title":{"support":"Prépositions et lieux","target":"Præpositioner og steder"},"situation":{"support":"Choisir les prépositions fréquentes avec les villes, pays, travail, transport et lieux quotidiens.","target":"Vælge almindelige præpositioner med byer, lande, arbejde, transport og hverdagssteder."},"tags":["prepositions","places"],"items":[{"id":"item.grammar.prepositions.1","order":1,"type":"grammar-example","text":{"support":"J’habite au Danemark.","target":"Jeg bor i Danmark."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« I » est fréquent avec les pays et les villes : i Danmark, i København.","targetExample":"i Danmark"}},"tags":["prepositions"]},{"id":"item.grammar.prepositions.2","order":2,"type":"grammar-example","text":{"support":"Je suis à Copenhague.","target":"Jeg er i København."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Les villes prennent normalement « i ».","targetExample":"i København"}},"tags":["prepositions"]},{"id":"item.grammar.prepositions.3","order":3,"type":"grammar-example","text":{"support":"Je suis au travail.","target":"Jeg er på arbejde."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Certaines expressions fixes utilisent « på » : på arbejde.","targetExample":"på arbejde"}},"tags":["prepositions"]},{"id":"item.grammar.prepositions.4","order":4,"type":"grammar-example","text":{"support":"Je suis à l’hôtel.","target":"Jeg er på hotellet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Pour de nombreux établissements/activités, « på » est courant : på hotellet, på café.","targetExample":"på hotellet"}},"tags":["prepositions"]},{"id":"item.grammar.prepositions.5","order":5,"type":"grammar-example","text":{"support":"Je vais à la gare.","target":"Jeg går hen til stationen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Til » marque souvent la destination. « Hen » peut souligner le mouvement vers un lieu proche/défini.","targetExample":"hen til stationen"}},"tags":["prepositions","movement"]},{"id":"item.grammar.prepositions.6","order":6,"type":"grammar-example","text":{"support":"Je vais au travail.","target":"Jeg tager på arbejde."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"L’expression fixe est « på arbejde » également avec un mouvement : tage på arbejde.","targetExample":"tage på arbejde"}},"tags":["prepositions"]},{"id":"item.grammar.prepositions.7","order":7,"type":"grammar-example","text":{"support":"Je voyage en train.","target":"Jeg tager med tog."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Med » est courant pour le moyen de transport : med tog, med bus.","targetExample":"med tog"}},"tags":["transport","prepositions"]},{"id":"item.grammar.prepositions.8","order":8,"type":"grammar-example","text":{"support":"Je descends du bus.","target":"Jeg står af bussen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Stå af » est un verbe à particule ; dans cette construction, le véhicule suit directement : stå af bussen.","targetExample":"stå af bussen"}},"tags":["transport","particle-verb"]},{"id":"item.grammar.prepositions.9","order":9,"type":"grammar-example","text":{"support":"Je parle avec ma collègue.","target":"Jeg taler med min kollega."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Tale med » = parler avec quelqu’un.","targetExample":"tale med"}},"tags":["prepositions"]},{"id":"item.grammar.prepositions.10","order":10,"type":"grammar-example","text":{"support":"J’attends le train.","target":"Jeg venter på toget."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Vente på » exige « på », contrairement au français « attendre » sans préposition.","targetExample":"vente på"}},"tags":["prepositions"]}],"quiz":{"id":"quiz.grammar.prepositions","title":{"support":"Mini-quiz — Prépositions","target":"Miniquiz — Præpositioner"},"questions":[{"id":"question.grammar.prepositions.1","order":1,"type":"single-choice","prompt":{"support":"Quelle expression signifie « au Danemark » ?","target":"Hvilket udtryk betyder ‘au Danemark’?"},"answers":[{"id":"answer.grammar.prepositions.1c","text":{"support":"au Danemark","target":"i Danmark"},"correct":true},{"id":"answer.grammar.prepositions.1w1","text":{"support":"au Danemark","target":"på Danmark"},"correct":false},{"id":"answer.grammar.prepositions.1w2","text":{"support":"au Danemark","target":"med Danmark"},"correct":false}],"explanation":{"support":"Les pays comme Danmark prennent « i ».","target":"Man siger ‘i Danmark’."},"tags":["prepositions"]},{"id":"question.grammar.prepositions.2","order":2,"type":"single-choice","prompt":{"support":"Quelle expression signifie « attendre le train » ?","target":"Hvilket udtryk betyder ‘attendre le train’?"},"answers":[{"id":"answer.grammar.prepositions.2c","text":{"support":"attendre le train","target":"vente på toget"},"correct":true},{"id":"answer.grammar.prepositions.2w1","text":{"support":"attendre le train","target":"vente toget"},"correct":false},{"id":"answer.grammar.prepositions.2w2","text":{"support":"attendre le train","target":"vente med toget"},"correct":false}],"explanation":{"support":"Le verbe danois est « vente på ».","target":"‘Vente’ forbindes her med præpositionen ‘på’."},"tags":["prepositions"]},{"id":"question.grammar.prepositions.3","order":3,"type":"single-choice","prompt":{"support":"Comment dit-on « en train » comme moyen de transport ?","target":"Hvordan siger man ‘en train’ som transportmiddel?"},"answers":[{"id":"answer.grammar.prepositions.3c","text":{"support":"en train","target":"med tog"},"correct":true},{"id":"answer.grammar.prepositions.3w1","text":{"support":"en train","target":"i tog"},"correct":false},{"id":"answer.grammar.prepositions.3w2","text":{"support":"en train","target":"på tog"},"correct":false}],"explanation":{"support":"« Med » est courant pour le moyen de transport.","target":"Transportmidlet kan udtrykkes med ‘med’: ‘med tog’."},"tags":["transport"]}]}},{"id":"lesson.grammar.adjectives","moduleId":"module.grammar","order":9,"title":{"support":"Adjectifs et comparaison","target":"Tillægsord og sammenligning"},"situation":{"support":"Adapter les adjectifs au nom et comparer des options simples.","target":"Bøje tillægsord efter navneordet og sammenligne enkle muligheder."},"tags":["adjectives","comparison"],"items":[{"id":"item.grammar.adjectives.1","order":1,"type":"grammar-example","text":{"support":"un bon café","target":"en god café"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Avec un nom en « en » indéfini singulier, l’adjectif a souvent sa forme de base.","targetExample":"en god café"}},"tags":["adjectives"]},{"id":"item.grammar.adjectives.2","order":2,"type":"grammar-example","text":{"support":"un bon hôtel","target":"et godt hotel"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Avec un nom neutre en « et », de nombreux adjectifs prennent -t : god → godt.","targetExample":"et godt hotel"}},"tags":["adjectives"]},{"id":"item.grammar.adjectives.3","order":3,"type":"grammar-example","text":{"support":"de bons restaurants","target":"gode restauranter"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Au pluriel, de nombreux adjectifs prennent -e : god → gode.","targetExample":"gode restauranter"}},"tags":["adjectives","plural"]},{"id":"item.grammar.adjectives.4","order":4,"type":"grammar-example","text":{"support":"le bon hôtel","target":"det gode hotel"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Avec adjectif + nom défini, le danois utilise souvent det/den/de + adjectif en -e + nom indéfini : det gode hotel.","targetExample":"det gode hotel"}},"tags":["adjectives","definiteness"]},{"id":"item.grammar.adjectives.5","order":5,"type":"grammar-example","text":{"support":"La chambre est grande.","target":"Værelset er stort."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Après « er », l’adjectif s’accorde également avec le sujet neutre : værelset er stort.","targetExample":"Værelset er stort."}},"tags":["adjectives"]},{"id":"item.grammar.adjectives.6","order":6,"type":"grammar-example","text":{"support":"Les chambres sont grandes.","target":"Værelserne er store."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Au pluriel : store.","targetExample":"Værelserne er store."}},"tags":["adjectives","plural"]},{"id":"item.grammar.adjectives.7","order":7,"type":"grammar-example","text":{"support":"Ce billet est moins cher.","target":"Den her billet er billigere."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Le comparatif de nombreux adjectifs prend -ere : billig → billigere.","targetExample":"billig → billigere"}},"tags":["comparison"]},{"id":"item.grammar.adjectives.8","order":8,"type":"grammar-example","text":{"support":"Le train est plus rapide que le bus.","target":"Toget er hurtigere end bussen."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« End » = que après un comparatif.","targetExample":"hurtigere end"}},"tags":["comparison"]},{"id":"item.grammar.adjectives.9","order":9,"type":"grammar-example","text":{"support":"C’est la solution la plus simple.","target":"Det er den nemmeste løsning."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Le superlatif attributif/défini prend souvent -este avec « den/det » : den nemmeste.","targetExample":"den nemmeste"}},"tags":["superlative"]},{"id":"item.grammar.adjectives.10","order":10,"type":"grammar-example","text":{"support":"Le plus important est le billet.","target":"Det vigtigste er billetten."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Une forme superlative peut être substantivée avec « det » : det vigtigste.","targetExample":"det vigtigste"}},"tags":["superlative"]}],"quiz":{"id":"quiz.grammar.adjectives","title":{"support":"Mini-quiz — Adjectifs","target":"Miniquiz — Tillægsord"},"questions":[{"id":"question.grammar.adjectives.1","order":1,"type":"single-choice","prompt":{"support":"Quelle forme convient avec « et hotel » ?","target":"Hvilken form passer til ‘et hotel’?"},"answers":[{"id":"answer.grammar.adjectives.1c","text":{"support":"un bon hôtel","target":"et godt hotel"},"correct":true},{"id":"answer.grammar.adjectives.1w1","text":{"support":"un bon hôtel","target":"et god hotel"},"correct":false},{"id":"answer.grammar.adjectives.1w2","text":{"support":"un bon hôtel","target":"et gode hotel"},"correct":false}],"explanation":{"support":"Le neutre singulier prend ici -t.","target":"Intetkøn ental har her formen ‘godt’."},"tags":["adjectives"]},{"id":"question.grammar.adjectives.2","order":2,"type":"single-choice","prompt":{"support":"Quel est le comparatif de « billig » ?","target":"Hvad er komparativ af ‘billig’?"},"answers":[{"id":"answer.grammar.adjectives.2c","text":{"support":"moins cher","target":"billigere"},"correct":true},{"id":"answer.grammar.adjectives.2w1","text":{"support":"bon marché","target":"billigt"},"correct":false},{"id":"answer.grammar.adjectives.2w2","text":{"support":"le moins cher","target":"billigst"},"correct":false}],"explanation":{"support":"« Billigere » est le comparatif.","target":"Komparativ er ‘billigere’."},"tags":["comparison"]},{"id":"question.grammar.adjectives.3","order":3,"type":"single-choice","prompt":{"support":"Quel mot signifie « que » dans une comparaison ?","target":"Hvilket ord betyder ‘que’ i en sammenligning?"},"answers":[{"id":"answer.grammar.adjectives.3c","text":{"support":"que","target":"end"},"correct":true},{"id":"answer.grammar.adjectives.3w1","text":{"support":"et","target":"og"},"correct":false},{"id":"answer.grammar.adjectives.3w2","text":{"support":"mais","target":"men"},"correct":false}],"explanation":{"support":"« Hurtigere end » = plus rapide que.","target":"Efter komparativ bruges ‘end’."},"tags":["comparison"]}]}},{"id":"lesson.grammar.everyday-patterns","moduleId":"module.grammar","order":10,"title":{"support":"Structures utiles au quotidien","target":"Nyttige hverdagskonstruktioner"},"situation":{"support":"Réviser des structures très fréquentes qui ne se traduisent pas mot à mot du français.","target":"Repetere meget almindelige konstruktioner, som ikke oversættes ord for ord fra fransk."},"tags":["patterns","everyday"],"items":[{"id":"item.grammar.everyday-patterns.1","order":1,"type":"grammar-example","text":{"support":"Je voudrais un café.","target":"Jeg vil gerne have en kaffe."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Vil gerne » exprime un souhait poli et correspond souvent à « voudrais/aimerais ».","targetExample":"Jeg vil gerne …"}},"tags":["politeness","pattern"]},{"id":"item.grammar.everyday-patterns.2","order":2,"type":"grammar-example","text":{"support":"J’ai envie d’aller au musée.","target":"Jeg har lyst til at gå på museum."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Have lyst til at » = avoir envie de + infinitif.","targetExample":"har lyst til at"}},"tags":["pattern"]},{"id":"item.grammar.everyday-patterns.3","order":3,"type":"grammar-example","text":{"support":"J’ai besoin d’aide.","target":"Jeg har brug for hjælp."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Have brug for » = avoir besoin de.","targetExample":"har brug for"}},"tags":["pattern","help"]},{"id":"item.grammar.everyday-patterns.4","order":4,"type":"grammar-example","text":{"support":"Je suis en train d’apprendre le danois.","target":"Jeg er ved at lære dansk."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Være ved at » peut exprimer une action en cours, sans être obligatoire chaque fois que le français utilise « être en train de ».","targetExample":"er ved at lære"}},"tags":["pattern"]},{"id":"item.grammar.everyday-patterns.5","order":5,"type":"grammar-example","text":{"support":"Je vais partir.","target":"Jeg skal til at gå."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Skulle til at » exprime être sur le point de/aller faire quelque chose.","targetExample":"skal til at gå"}},"tags":["pattern"]},{"id":"item.grammar.everyday-patterns.6","order":6,"type":"grammar-example","text":{"support":"J’ai réussi à me connecter.","target":"Det lykkedes mig at logge ind."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Det lykkedes mig at … » = j’ai réussi à … ; la construction danoise est impersonnelle.","targetExample":"Det lykkedes mig at …"}},"tags":["pattern"]},{"id":"item.grammar.everyday-patterns.7","order":7,"type":"grammar-example","text":{"support":"Je n’arrive pas à ouvrir l’application.","target":"Jeg kan ikke få appen til at åbne."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Få noget til at + infinitif » exprime faire en sorte que quelque chose fonctionne/se produise.","targetExample":"få appen til at åbne"}},"tags":["causative","digital"]},{"id":"item.grammar.everyday-patterns.8","order":8,"type":"grammar-example","text":{"support":"Plus je pratique, plus je comprends.","target":"Jo mere jeg øver mig, jo mere forstår jeg."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"La corrélation « plus … plus … » se construit avec « jo … jo … ».","targetExample":"jo mere …, jo mere …"}},"tags":["comparison","pattern"]},{"id":"item.grammar.everyday-patterns.9","order":9,"type":"grammar-example","text":{"support":"Cela dépend de l’heure.","target":"Det kommer an på tidspunktet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Komme an på » = dépendre de.","targetExample":"det kommer an på"}},"tags":["particle-verb","pattern"]},{"id":"item.grammar.everyday-patterns.10","order":10,"type":"grammar-example","text":{"support":"Ça ne fait rien.","target":"Det gør ikke noget."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"Expression idiomatique très fréquente pour dire que ce n’est pas grave.","targetExample":"Det gør ikke noget."}},"tags":["idiom","pattern"]}],"quiz":{"id":"quiz.grammar.everyday-patterns","title":{"support":"Mini-quiz — Structures utiles","target":"Miniquiz — Nyttige konstruktioner"},"questions":[{"id":"question.grammar.everyday-patterns.1","order":1,"type":"single-choice","prompt":{"support":"Comment dit-on poliment « je voudrais » ?","target":"Hvordan udtrykker man ofte høfligt ‘je voudrais’?"},"answers":[{"id":"answer.grammar.everyday-patterns.1c","text":{"support":"je voudrais","target":"jeg vil gerne"},"correct":true},{"id":"answer.grammar.everyday-patterns.1w1","text":{"support":"je dois","target":"jeg skal"},"correct":false},{"id":"answer.grammar.everyday-patterns.1w2","text":{"support":"je peux","target":"jeg kan"},"correct":false}],"explanation":{"support":"« Jeg vil gerne … » est une formule très fréquente.","target":"‘Jeg vil gerne …’ udtrykker et ønske på en venlig måde."},"tags":["politeness"]},{"id":"question.grammar.everyday-patterns.2","order":2,"type":"single-choice","prompt":{"support":"Quelle construction signifie « avoir besoin de » ?","target":"Hvilken konstruktion betyder ‘avoir besoin de’?"},"answers":[{"id":"answer.grammar.everyday-patterns.2c","text":{"support":"avoir besoin de","target":"have brug for"},"correct":true},{"id":"answer.grammar.everyday-patterns.2w1","text":{"support":"avoir envie de","target":"have lyst til"},"correct":false},{"id":"answer.grammar.everyday-patterns.2w2","text":{"support":"dépendre de","target":"komme an på"},"correct":false}],"explanation":{"support":"« Jeg har brug for hjælp » = j’ai besoin d’aide.","target":"‘Have brug for’ betyder at have behov for noget."},"tags":["pattern"]},{"id":"question.grammar.everyday-patterns.3","order":3,"type":"single-choice","prompt":{"support":"Comment se construit « plus … plus … » ?","target":"Hvordan konstrueres ‘plus … plus …’?"},"answers":[{"id":"answer.grammar.everyday-patterns.3c","text":{"support":"plus … plus …","target":"jo … jo …"},"correct":true},{"id":"answer.grammar.everyday-patterns.3w1","text":{"support":"si … alors …","target":"hvis … så …"},"correct":false},{"id":"answer.grammar.everyday-patterns.3w2","text":{"support":"soit … soit …","target":"enten … eller …"},"correct":false}],"explanation":{"support":"« Jo mere …, jo mere … » correspond à « plus …, plus … ».","target":"Sammenhængen udtrykkes med ‘jo … jo …’."},"tags":["comparison"]}]}}]}]}}
