{"schemaVersion":1,"contentVersion":"0.1.0-children-01-05","course":{"id":"course.fr-da","courseLocale":"fr-FR","languages":{"support":{"language":"fr","locale":"fr-FR"},"target":{"language":"da","locale":"da-DK"}},"tts":{"primaryRole":"target","targetLocale":"da-DK","supportLocale":"fr-FR"},"title":{"support":"Danois pratique","target":"Praktisk dansk"},"modules":[{"id":"module.children","type":"children","audience":"children","title":{"support":"Enfants — Le danois au quotidien","target":"Børn — Dansk i hverdagen"},"tags":["children","everyday","safety"],"lessons":[{"id":"lesson.children.meet-kids","moduleId":"module.children","order":1,"title":{"support":"Rencontrer d’autres enfants","target":"Møde andre børn"},"situation":{"support":"Tu arrives dans un parc et tu voudrais jouer avec des enfants danois. Tu te présentes et tu demandes si tu peux participer.","target":"Du kommer til en park og vil gerne lege med nogle danske børn. Du præsenterer dig og spørger, om du må være med."},"tags":["friends","play"],"items":[{"id":"item.children.meet.1","order":1,"type":"dialogue-turn","speaker":"A","text":{"support":"Salut ! Comment tu t’appelles ?","target":"Hej! Hvad hedder du?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Hvad hedder du? » est la manière habituelle de demander le nom.","targetExample":"Hvad hedder du?"}},"tags":["introduction"]},{"id":"item.children.meet.2","order":2,"type":"dialogue-turn","speaker":"B","text":{"support":"Je m’appelle Emil. Et toi ?","target":"Jeg hedder Emil. Hvad med dig?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["introduction"]},{"id":"item.children.meet.3","order":3,"type":"dialogue-turn","speaker":"A","text":{"support":"Je m’appelle Lucas. Je viens de France.","target":"Jeg hedder Lucas. Jeg kommer fra Frankrig."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["country"]},{"id":"item.children.meet.4","order":4,"type":"dialogue-turn","speaker":"A","text":{"support":"Vous jouez à quoi ?","target":"Hvad leger I?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« I » signifie vous au pluriel.","targetExample":"Hvad leger I?"}},"tags":["play"]},{"id":"item.children.meet.5","order":5,"type":"dialogue-turn","speaker":"B","text":{"support":"On joue au football.","target":"Vi spiller fodbold."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["sport"]},{"id":"item.children.meet.6","order":6,"type":"dialogue-turn","speaker":"A","text":{"support":"Je peux jouer avec vous ?","target":"Må jeg være med?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Må jeg …? » sert à demander la permission.","targetExample":"Må jeg være med?"}},"tags":["permission"]},{"id":"item.children.meet.7","order":7,"type":"dialogue-turn","speaker":"B","text":{"support":"Oui, bien sûr !","target":"Ja, selvfølgelig!"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["acceptance"]},{"id":"item.children.meet.8","order":8,"type":"dialogue-turn","speaker":"A","text":{"support":"Je ne parle pas très bien danois.","target":"Jeg taler ikke så godt dansk."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["language"]},{"id":"item.children.meet.9","order":9,"type":"dialogue-turn","speaker":"B","text":{"support":"Ce n’est pas grave.","target":"Det gør ikke noget."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"cultural":{"support":"« Det gør ikke noget » est une réponse fréquente pour rassurer : ce n’est pas grave."}},"tags":["reassurance"]},{"id":"item.children.meet.10","order":10,"type":"dialogue-turn","speaker":"A","text":{"support":"Super, on joue !","target":"Fedt, lad os spille!"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["play"]}],"quiz":{"id":"quiz.children.meet","title":{"support":"Mini-quiz — Nouveaux amis","target":"Miniquiz — Nye venner"},"questions":[{"id":"q.children.meet.1","order":1,"type":"single-choice","prompt":{"support":"Comment demandes-tu si tu peux participer ?","target":"Hvordan spørger du, om du må være med?"},"answers":[{"id":"a.children.meet.1c","text":{"support":"Je peux jouer avec vous ?","target":"Må jeg være med?"},"correct":true},{"id":"a.children.meet.1w1","text":{"support":"Où habites-tu ?","target":"Hvor bor du?"},"correct":false},{"id":"a.children.meet.1w2","text":{"support":"Quel âge as-tu ?","target":"Hvor gammel er du?"},"correct":false}],"explanation":{"support":"« Må jeg være med? » est très utile dans les jeux.","target":"‘Må jeg være med?’ bruges til at spørge om lov til at deltage."},"tags":["permission"]},{"id":"q.children.meet.2","order":2,"type":"single-choice","prompt":{"support":"Que signifie « Vi spiller fodbold » ?","target":"Hvad betyder ‘Vi spiller fodbold’?"},"answers":[{"id":"a.children.meet.2c","text":{"support":"On joue au football.","target":"Vi spiller fodbold."},"correct":true},{"id":"a.children.meet.2w1","text":{"support":"On regarde le football.","target":"Vi ser fodbold."},"correct":false},{"id":"a.children.meet.2w2","text":{"support":"On rentre.","target":"Vi går hjem."},"correct":false}],"explanation":{"support":"« Spille » est utilisé pour jouer à un sport ou à un jeu.","target":"‘Spille’ bruges blandt andet om sport og spil."},"tags":["sport"]},{"id":"q.children.meet.3","order":3,"type":"single-choice","prompt":{"support":"Comment dis-tu que ton danois n’est pas encore très bon ?","target":"Hvordan siger du, at dit dansk ikke er så godt endnu?"},"answers":[{"id":"a.children.meet.3c","text":{"support":"Je ne parle pas très bien danois.","target":"Jeg taler ikke så godt dansk."},"correct":true},{"id":"a.children.meet.3w1","text":{"support":"Je ne parle pas français.","target":"Jeg taler ikke fransk."},"correct":false},{"id":"a.children.meet.3w2","text":{"support":"Je comprends tout.","target":"Jeg forstår alt."},"correct":false}],"explanation":{"support":"Cette phrase aide à expliquer simplement une difficulté linguistique.","target":"Sætningen forklarer enkelt, at man stadig lærer dansk."},"tags":["language"]}]}},{"id":"lesson.children.school","moduleId":"module.children","order":2,"title":{"support":"À l’école et au centre de loisirs","target":"I skole og SFO"},"situation":{"support":"C’est ton premier jour dans une école danoise. Tu dois trouver ta classe, comprendre une consigne et demander de l’aide.","target":"Det er din første dag på en dansk skole. Du skal finde din klasse, forstå en besked og bede om hjælp."},"tags":["school","sfo"],"items":[{"id":"item.children.school.1","order":1,"type":"dialogue-turn","speaker":"A","text":{"support":"Où est ma classe ?","target":"Hvor er min klasse?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["directions"]},{"id":"item.children.school.2","order":2,"type":"dialogue-turn","speaker":"B","text":{"support":"Elle est au premier étage.","target":"Den er på første sal."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["directions"]},{"id":"item.children.school.3","order":3,"type":"dialogue-turn","speaker":"A","text":{"support":"Je ne comprends pas la consigne.","target":"Jeg forstår ikke beskeden."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["understanding"]},{"id":"item.children.school.4","order":4,"type":"dialogue-turn","speaker":"A","text":{"support":"Tu peux répéter, s’il te plaît ?","target":"Kan du sige det igen?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["communication-strategy"]},{"id":"item.children.school.5","order":5,"type":"dialogue-turn","speaker":"B","text":{"support":"Oui. Ouvre ton livre à la page douze.","target":"Ja. Slå op på side tolv."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Slå op på side … » signifie ouvrir le livre à la page …","targetExample":"Slå op på side tolv."}},"tags":["instruction"]},{"id":"item.children.school.6","order":6,"type":"dialogue-turn","speaker":"A","text":{"support":"On a une pause quand ?","target":"Hvornår har vi pause?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["time"]},{"id":"item.children.school.7","order":7,"type":"dialogue-turn","speaker":"B","text":{"support":"Dans dix minutes.","target":"Om ti minutter."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["time"]},{"id":"item.children.school.8","order":8,"type":"dialogue-turn","speaker":"A","text":{"support":"Où dois-je aller après l’école ?","target":"Hvor skal jeg gå hen efter skole?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["sfo","directions"]},{"id":"item.children.school.9","order":9,"type":"dialogue-turn","speaker":"B","text":{"support":"Tu vas au SFO avec les autres.","target":"Du går i SFO med de andre."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"cultural":{"support":"SFO est le terme courant pour un accueil périscolaire dans de nombreuses écoles danoises ; l’organisation varie selon la commune et l’école."}},"tags":["sfo"]},{"id":"item.children.school.10","order":10,"type":"dialogue-turn","speaker":"A","text":{"support":"D’accord. Je peux suivre Emma ?","target":"Okay. Må jeg følges med Emma?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["permission"]}],"quiz":{"id":"quiz.children.school","title":{"support":"Mini-quiz — École","target":"Miniquiz — Skole"},"questions":[{"id":"q.children.school.1","order":1,"type":"single-choice","prompt":{"support":"Comment demandes-tu à quelqu’un de répéter ?","target":"Hvordan beder du nogen gentage?"},"answers":[{"id":"a.children.school.1c","text":{"support":"Tu peux répéter ?","target":"Kan du sige det igen?"},"correct":true},{"id":"a.children.school.1w1","text":{"support":"Tu peux partir ?","target":"Kan du gå?"},"correct":false},{"id":"a.children.school.1w2","text":{"support":"Tu peux écrire ?","target":"Kan du skrive?"},"correct":false}],"explanation":{"support":"« Sige det igen » signifie dire cela de nouveau.","target":"‘Sige det igen’ betyder at gentage."},"tags":["communication"]},{"id":"q.children.school.2","order":2,"type":"single-choice","prompt":{"support":"Que signifie « pause » en danois ?","target":"Hvad betyder ‘pause’?"},"answers":[{"id":"a.children.school.2c","text":{"support":"récréation/pause","target":"pause"},"correct":true},{"id":"a.children.school.2w1","text":{"support":"devoirs","target":"lektier"},"correct":false},{"id":"a.children.school.2w2","text":{"support":"classe","target":"klasse"},"correct":false}],"explanation":{"support":"Le mot « pause » est transparent et très utile à l’école.","target":"‘Pause’ bruges om et ophold mellem aktiviteter eller timer."},"tags":["school"]},{"id":"q.children.school.3","order":3,"type":"single-choice","prompt":{"support":"Que signifie « Om ti minutter » ?","target":"Hvad betyder ‘Om ti minutter’?"},"answers":[{"id":"a.children.school.3c","text":{"support":"Dans dix minutes.","target":"Om ti minutter."},"correct":true},{"id":"a.children.school.3w1","text":{"support":"Pendant dix minutes.","target":"I ti minutter."},"correct":false},{"id":"a.children.school.3w2","text":{"support":"Il y a dix minutes.","target":"For ti minutter siden."},"correct":false}],"explanation":{"support":"« Om » + durée indique dans combien de temps quelque chose aura lieu.","target":"‘Om ti minutter’ peger frem i tiden."},"tags":["time"]}]}},{"id":"lesson.children.lost","moduleId":"module.children","order":3,"title":{"support":"Je me suis perdu","target":"Jeg er blevet væk"},"situation":{"support":"Tu ne retrouves plus l’adulte avec qui tu étais. Tu restes dans un endroit sûr et demandes de l’aide à un adulte responsable ou à un employé.","target":"Du kan ikke finde den voksne, du var sammen med. Du bliver et sikkert sted og beder en ansvarlig voksen eller en medarbejder om hjælp."},"tags":["lost","safety","help"],"items":[{"id":"item.children.lost.1","order":1,"type":"dialogue-turn","speaker":"A","text":{"support":"Excusez-moi, je me suis perdu.","target":"Undskyld, jeg er blevet væk."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["help"]},{"id":"item.children.lost.2","order":2,"type":"dialogue-turn","speaker":"B","text":{"support":"D’accord. Avec qui étais-tu ?","target":"Okay. Hvem var du sammen med?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["question"]},{"id":"item.children.lost.3","order":3,"type":"dialogue-turn","speaker":"A","text":{"support":"J’étais avec ma mère.","target":"Jeg var sammen med min mor."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Var » est le passé de « være ».","targetExample":"Jeg var sammen med min mor."}},"tags":["past","family"]},{"id":"item.children.lost.4","order":4,"type":"dialogue-turn","speaker":"B","text":{"support":"Tu connais son numéro de téléphone ?","target":"Kender du hendes telefonnummer?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["phone"]},{"id":"item.children.lost.5","order":5,"type":"dialogue-turn","speaker":"A","text":{"support":"Oui, il est dans mon téléphone.","target":"Ja, det er på min telefon."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["phone"]},{"id":"item.children.lost.6","order":6,"type":"dialogue-turn","speaker":"A","text":{"support":"Vous pouvez m’aider à l’appeler ?","target":"Kan du hjælpe mig med at ringe til hende?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["help","phone"]},{"id":"item.children.lost.7","order":7,"type":"dialogue-turn","speaker":"B","text":{"support":"Oui. Reste ici avec moi.","target":"Ja. Bliv her sammen med mig."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"cultural":{"support":"Pour un enfant perdu, l’objectif est de demander de l’aide à une personne identifiable et responsable et de rester dans un lieu sûr plutôt que de partir seul à la recherche de sa famille."}},"tags":["safety"]},{"id":"item.children.lost.8","order":8,"type":"dialogue-turn","speaker":"A","text":{"support":"Je porte une veste rouge.","target":"Jeg har en rød jakke på."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"grammar":{"support":"« Have … på » est utilisé pour les vêtements portés.","targetExample":"Jeg har en rød jakke på."}},"tags":["description"]},{"id":"item.children.lost.9","order":9,"type":"dialogue-turn","speaker":"A","text":{"support":"Ma mère a les cheveux bruns.","target":"Min mor har brunt hår."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["description"]},{"id":"item.children.lost.10","order":10,"type":"dialogue-turn","speaker":"B","text":{"support":"Très bien. Nous allons chercher de l’aide.","target":"Godt. Vi finder nogen, der kan hjælpe."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["help"]}],"quiz":{"id":"quiz.children.lost","title":{"support":"Mini-quiz — Perdu","target":"Miniquiz — Blevet væk"},"questions":[{"id":"q.children.lost.1","order":1,"type":"single-choice","prompt":{"support":"Comment dis-tu que tu t’es perdu ?","target":"Hvordan siger du, at du er blevet væk?"},"answers":[{"id":"a.children.lost.1c","text":{"support":"Je me suis perdu.","target":"Jeg er blevet væk."},"correct":true},{"id":"a.children.lost.1w1","text":{"support":"Je suis fatigué.","target":"Jeg er træt."},"correct":false},{"id":"a.children.lost.1w2","text":{"support":"Je rentre chez moi.","target":"Jeg går hjem."},"correct":false}],"explanation":{"support":"« Jeg er blevet væk » est la phrase essentielle de cette situation.","target":"Sætningen fortæller tydeligt, at barnet ikke kan finde den person, det var sammen med."},"tags":["safety"]},{"id":"q.children.lost.2","order":2,"type":"single-choice","prompt":{"support":"Comment demandes-tu de l’aide pour téléphoner ?","target":"Hvordan beder du om hjælp til at ringe?"},"answers":[{"id":"a.children.lost.2c","text":{"support":"Vous pouvez m’aider à l’appeler ?","target":"Kan du hjælpe mig med at ringe til hende?"},"correct":true},{"id":"a.children.lost.2w1","text":{"support":"Vous avez un billet ?","target":"Har du en billet?"},"correct":false},{"id":"a.children.lost.2w2","text":{"support":"Où est le bus ?","target":"Hvor er bussen?"},"correct":false}],"explanation":{"support":"« Hjælpe mig med at … » sert à demander de l’aide pour une action.","target":"‘Hjælpe mig med at’ bruges, når man har brug for hjælp til noget."},"tags":["help"]},{"id":"q.children.lost.3","order":3,"type":"single-choice","prompt":{"support":"Que signifie « Bliv her » ?","target":"Hvad betyder ‘Bliv her’?"},"answers":[{"id":"a.children.lost.3c","text":{"support":"Reste ici.","target":"Bliv her."},"correct":true},{"id":"a.children.lost.3w1","text":{"support":"Cours vite.","target":"Løb hurtigt."},"correct":false},{"id":"a.children.lost.3w2","text":{"support":"Va dehors.","target":"Gå udenfor."},"correct":false}],"explanation":{"support":"« Bliv » est l’impératif de « blive » : rester.","target":"‘Bliv her’ betyder, at man skal blive på stedet."},"tags":["safety"]}]}},{"id":"lesson.children.shop-cafe","moduleId":"module.children","order":4,"title":{"support":"Au magasin et au café","target":"I butik og på café"},"situation":{"support":"Tu veux acheter une petite chose et commander quelque chose à boire. Tu dois comprendre le prix et dire ce que tu veux.","target":"Du vil købe en lille ting og bestille noget at drikke. Du skal forstå prisen og sige, hvad du gerne vil have."},"tags":["shop","cafe","money"],"items":[{"id":"item.children.shop.1","order":1,"type":"dialogue-turn","speaker":"A","text":{"support":"Combien ça coûte ?","target":"Hvad koster den?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["price"]},{"id":"item.children.shop.2","order":2,"type":"dialogue-turn","speaker":"B","text":{"support":"Ça coûte vingt-cinq couronnes.","target":"Den koster femogtyve kroner."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["numbers","price"]},{"id":"item.children.shop.3","order":3,"type":"dialogue-turn","speaker":"A","text":{"support":"Je voudrais celle-ci.","target":"Jeg vil gerne have den her."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["shopping"]},{"id":"item.children.shop.4","order":4,"type":"dialogue-turn","speaker":"B","text":{"support":"Tu veux un sac ?","target":"Vil du have en pose?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["shopping"]},{"id":"item.children.shop.5","order":5,"type":"dialogue-turn","speaker":"A","text":{"support":"Non merci.","target":"Nej tak."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["politeness"]},{"id":"item.children.shop.6","order":6,"type":"dialogue-turn","speaker":"A","text":{"support":"Je voudrais un jus de pomme, s’il vous plaît.","target":"Jeg vil gerne have en æblejuice, tak."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["cafe"]},{"id":"item.children.shop.7","order":7,"type":"dialogue-turn","speaker":"B","text":{"support":"Petit ou grand ?","target":"Lille eller stor?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["size"]},{"id":"item.children.shop.8","order":8,"type":"dialogue-turn","speaker":"A","text":{"support":"Petit, s’il vous plaît.","target":"En lille, tak."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["cafe"]},{"id":"item.children.shop.9","order":9,"type":"dialogue-turn","speaker":"A","text":{"support":"Je peux payer avec cette carte ?","target":"Kan jeg betale med det her kort?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"digital":{"support":"Les enfants peuvent rencontrer différents moyens de paiement selon leur famille et leur âge. La leçon apprend à demander si un moyen de paiement est accepté, sans supposer qu’un enfant dispose de MobilePay ou d’une carte particulière."}},"tags":["payment"]},{"id":"item.children.shop.10","order":10,"type":"dialogue-turn","speaker":"B","text":{"support":"Oui, c’est bon.","target":"Ja, det kan du godt."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["payment"]}],"quiz":{"id":"quiz.children.shop","title":{"support":"Mini-quiz — Magasin et café","target":"Miniquiz — Butik og café"},"questions":[{"id":"q.children.shop.1","order":1,"type":"single-choice","prompt":{"support":"Comment demandes-tu le prix ?","target":"Hvordan spørger du om prisen?"},"answers":[{"id":"a.children.shop.1c","text":{"support":"Combien ça coûte ?","target":"Hvad koster den?"},"correct":true},{"id":"a.children.shop.1w1","text":{"support":"Où est-elle ?","target":"Hvor er den?"},"correct":false},{"id":"a.children.shop.1w2","text":{"support":"Qui l’a achetée ?","target":"Hvem har købt den?"},"correct":false}],"explanation":{"support":"« Hvad koster …? » sert à demander le prix.","target":"‘Hvad koster …?’ bruges til at spørge om en pris."},"tags":["price"]},{"id":"q.children.shop.2","order":2,"type":"single-choice","prompt":{"support":"Comment commandes-tu poliment quelque chose ?","target":"Hvordan bestiller du noget på en venlig måde?"},"answers":[{"id":"a.children.shop.2c","text":{"support":"Je voudrais …","target":"Jeg vil gerne have …"},"correct":true},{"id":"a.children.shop.2w1","text":{"support":"Donne-moi …","target":"Giv mig …"},"correct":false},{"id":"a.children.shop.2w2","text":{"support":"Je n’ai pas …","target":"Jeg har ikke …"},"correct":false}],"explanation":{"support":"« Jeg vil gerne have … » est une formulation simple et polie.","target":"‘Jeg vil gerne have …’ er en almindelig høflig bestilling."},"tags":["politeness"]},{"id":"q.children.shop.3","order":3,"type":"single-choice","prompt":{"support":"Que signifie « Nej tak » ?","target":"Hvad betyder ‘Nej tak’?"},"answers":[{"id":"a.children.shop.3c","text":{"support":"Non merci.","target":"Nej tak."},"correct":true},{"id":"a.children.shop.3w1","text":{"support":"Oui merci.","target":"Ja tak."},"correct":false},{"id":"a.children.shop.3w2","text":{"support":"À bientôt.","target":"Vi ses."},"correct":false}],"explanation":{"support":"« Nej tak » permet de refuser poliment.","target":"‘Nej tak’ er en høflig måde at sige nej på."},"tags":["politeness"]}]}},{"id":"lesson.children.library","moduleId":"module.children","order":5,"title":{"support":"À la bibliothèque","target":"På biblioteket"},"situation":{"support":"Tu visites une bibliothèque danoise. Tu cherches un livre, demandes comment l’emprunter et où utiliser un ordinateur.","target":"Du besøger et dansk bibliotek. Du leder efter en bog, spørger hvordan du låner den, og hvor du kan bruge en computer."},"tags":["library","books","computer"],"items":[{"id":"item.children.library.1","order":1,"type":"dialogue-turn","speaker":"A","text":{"support":"Où sont les livres pour enfants ?","target":"Hvor er børnebøgerne?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["books"]},{"id":"item.children.library.2","order":2,"type":"dialogue-turn","speaker":"B","text":{"support":"Ils sont là-bas, près de la fenêtre.","target":"De er derovre ved vinduet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["directions"]},{"id":"item.children.library.3","order":3,"type":"dialogue-turn","speaker":"A","text":{"support":"Avez-vous ce livre en français ?","target":"Har I den her bog på fransk?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["language","books"]},{"id":"item.children.library.4","order":4,"type":"dialogue-turn","speaker":"B","text":{"support":"Je vais regarder dans le catalogue.","target":"Jeg kigger i kataloget."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["catalogue"]},{"id":"item.children.library.5","order":5,"type":"dialogue-turn","speaker":"A","text":{"support":"Comment puis-je emprunter un livre ?","target":"Hvordan kan jeg låne en bog?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["borrowing"]},{"id":"item.children.library.6","order":6,"type":"dialogue-turn","speaker":"B","text":{"support":"Demande à un adulte de t’aider avec l’inscription si nécessaire.","target":"Få en voksen til at hjælpe dig med oprettelsen, hvis det er nødvendigt."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"cultural":{"support":"Les règles d’inscription et d’emprunt pour les enfants peuvent varier. La leçon évite donc de présenter une procédure unique."}},"tags":["help","registration"]},{"id":"item.children.library.7","order":7,"type":"dialogue-turn","speaker":"A","text":{"support":"Où puis-je utiliser un ordinateur ?","target":"Hvor kan jeg bruge en computer?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["computer"]},{"id":"item.children.library.8","order":8,"type":"dialogue-turn","speaker":"B","text":{"support":"Il y en a deux dans l’espace enfants.","target":"Der står to i børneområdet."},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["computer","numbers"]},{"id":"item.children.library.9","order":9,"type":"dialogue-turn","speaker":"A","text":{"support":"Il y a du Wi-Fi ici ?","target":"Er der wi-fi her?"},"tts":{"role":"target","locale":"da-DK","enabled":true},"tags":["internet"]},{"id":"item.children.library.10","order":10,"type":"dialogue-turn","speaker":"B","text":{"support":"Oui. Demande le nom du réseau et les règles d’utilisation.","target":"Ja. Spørg efter netværkets navn og reglerne for brug."},"tts":{"role":"target","locale":"da-DK","enabled":true},"notes":{"digital":{"support":"Les règles d’accès au réseau et aux ordinateurs varient d’une bibliothèque à l’autre. Un enfant doit suivre les règles locales et celles de ses responsables."}},"tags":["internet","rules"]}],"quiz":{"id":"quiz.children.library","title":{"support":"Mini-quiz — Bibliothèque","target":"Miniquiz — Bibliotek"},"questions":[{"id":"q.children.library.1","order":1,"type":"single-choice","prompt":{"support":"Comment demandes-tu où sont les livres pour enfants ?","target":"Hvordan spørger du, hvor børnebøgerne er?"},"answers":[{"id":"a.children.library.1c","text":{"support":"Où sont les livres pour enfants ?","target":"Hvor er børnebøgerne?"},"correct":true},{"id":"a.children.library.1w1","text":{"support":"Où est l’école ?","target":"Hvor er skolen?"},"correct":false},{"id":"a.children.library.1w2","text":{"support":"Combien coûte le livre ?","target":"Hvad koster bogen?"},"correct":false}],"explanation":{"support":"« Børnebøger » signifie livres pour enfants.","target":"‘Børnebøger’ er bøger for børn."},"tags":["books"]},{"id":"q.children.library.2","order":2,"type":"single-choice","prompt":{"support":"Quel verbe signifie « emprunter » ?","target":"Hvilket verbum betyder ‘emprunter’?"},"answers":[{"id":"a.children.library.2c","text":{"support":"emprunter","target":"låne"},"correct":true},{"id":"a.children.library.2w1","text":{"support":"acheter","target":"købe"},"correct":false},{"id":"a.children.library.2w2","text":{"support":"vendre","target":"sælge"},"correct":false}],"explanation":{"support":"« Låne » signifie emprunter ou prêter selon la construction et le contexte.","target":"‘Låne’ bruges om at låne noget; sammenhængen viser retningen."},"tags":["borrowing"]},{"id":"q.children.library.3","order":3,"type":"single-choice","prompt":{"support":"Comment demandes-tu s’il y a du Wi-Fi ?","target":"Hvordan spørger du, om der er wi-fi?"},"answers":[{"id":"a.children.library.3c","text":{"support":"Il y a du Wi-Fi ici ?","target":"Er der wi-fi her?"},"correct":true},{"id":"a.children.library.3w1","text":{"support":"Le Wi-Fi est cher ?","target":"Er wi-fi dyrt?"},"correct":false},{"id":"a.children.library.3w2","text":{"support":"Tu as un téléphone ?","target":"Har du en telefon?"},"correct":false}],"explanation":{"support":"« Er der …? » demande si quelque chose est présent/disponible.","target":"‘Er der …?’ spørger, om noget findes på stedet."},"tags":["internet"]}]}}]}]}}